---
interface Props {
  selected?: string;
  required?: boolean;
}
const { selected = '', required = true } = Astro.props;
---
<select name="category" required={required}
  class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm bg-white focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition">
  <option value="">Select a category…</option>
  <optgroup label="── International Public Law">
    <option value="international-law"              selected={selected==='international-law'}>🏛️  International Law</option>
    <option value="human-rights-law"               selected={selected==='human-rights-law'}>✊  International Human Rights Law</option>
    <option value="humanitarian-law"               selected={selected==='humanitarian-law'}>🕊️  International Humanitarian Law</option>
    <option value="international-criminal-law"     selected={selected==='international-criminal-law'}>⚖️  International Criminal Law</option>
    <option value="international-trade-law"        selected={selected==='international-trade-law'}>🤝  International Trade Law</option>
    <option value="international-environmental-law" selected={selected==='international-environmental-law'}>🌿  International Environmental Law</option>
    <option value="maritime-law"                   selected={selected==='maritime-law'}>⚓  International Maritime Law</option>
  </optgroup>
  <optgroup label="── Specialised Fields">
    <option value="international-investment-law"   selected={selected==='international-investment-law'}>📈  International Investment Law</option>
    <option value="diplomatic-law"                 selected={selected==='diplomatic-law'}>🎖️  Diplomatic &amp; Consular Law</option>
    <option value="air-space-law"                  selected={selected==='air-space-law'}>🚀  Air &amp; Space Law</option>
    <option value="refugee-law"                    selected={selected==='refugee-law'}>🏳️  International Refugee Law</option>
    <option value="international-labor-law"        selected={selected==='international-labor-law'}>🏗️  International Labour Law</option>
    <option value="intellectual-property-law"      selected={selected==='intellectual-property-law'}>💡  International IP Law</option>
  </optgroup>
  <optgroup label="── General &amp; Comparative">
    <option value="river-law"  selected={selected==='river-law'}>🌊  River &amp; Water Law</option>
    <option value="world-law"  selected={selected==='world-law'}>🌍  World Law</option>
  </optgroup>
</select>
