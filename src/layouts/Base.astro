---
import { CATEGORIES, CATEGORY_GROUPS } from '../lib/articles';
import type { CategorySlug } from '../lib/articles';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
}
const { title, description: rawDescription = 'Lex Research publishes free, peer-reviewed articles on international law, human rights, IHL, arbitration, and comparative legal systems. Open access, fully cited.', keywords = 'international law, legal research, world law, comparative law, open access, Lex Research' } = Astro.props;
// Google displays ~155 chars; trim to last complete sentence that fits, else word-boundary truncate
function trimDesc(s: string): string {
  if (s.length <= 155) return s;
  // try to end on a sentence boundary within 155 chars
  const cut = s.slice(0, 155);
  const lastSentence = cut.search(/[.!?][^.!?]*$/);
  if (lastSentence > 80) return s.slice(0, lastSentence + 1).trim();
  return cut.replace(/\s+\S*$/, '') + '…';
}
const description = trimDesc(rawDescription);
const path = Astro.url.pathname;

// Group categories for mobile drawer
const groups = Object.entries(CATEGORY_GROUPS).map(([groupKey, group]) => ({
  ...group,
  key: groupKey,
  categories: (Object.entries(CATEGORIES) as [CategorySlug, typeof CATEGORIES[CategorySlug]][])
    .filter(([, cat]) => cat.group === groupKey)
    .map(([slug, cat]) => ({ slug, ...cat })),
}));
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta name="keywords" content={keywords} />
  <meta name="theme-color" content="#0f172a" />
  <title>{title.includes('Lex Research') ? title : `${title} | Lex Research`}</title>
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <slot name="head" />
  <!-- JSON-LD: Organization + WebSite (all pages) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://www.lexresearch.org/#organization",
        "name": "Lex Research",
        "url": "https://www.lexresearch.org",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.lexresearch.org/lex-research-logo.png",
          "width": 512,
          "height": 512
        },
        "description": "Open-access peer-reviewed scholarship in international law, world law, and comparative legal studies.",
        "foundingDate": "2026",
        "founder": {
          "@type": "Person",
          "name": "Lamia Akhter",
          "url": "https://www.lexresearch.org/lamia-akhter"
        },
        "sameAs": [
          "https://www.facebook.com/lamia.a.sumaiya",
          "https://www.instagram.com/lamia.akhterr/",
          "https://www.linkedin.com/in/lamia-akhterr"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://www.lexresearch.org/#website",
        "url": "https://www.lexresearch.org",
        "name": "Lex Research",
        "description": "The World Through a Legal Lens — open-access international legal scholarship",
        "publisher": { "@id": "https://www.lexresearch.org/#organization" },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://www.lexresearch.org/articles?q={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
      }
    ]
  })} />
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-Q73PD1X6S5"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-Q73PD1X6S5');
  </script>
  <style>@import "../styles/global.css";</style>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; -webkit-tap-highlight-color: transparent; }
    .serif { font-family: 'Playfair Display', Georgia, serif; }

    /* Mobile drawer */
    #mobile-drawer { transform: translateX(-100%); transition: transform 0.28s cubic-bezier(0.4,0,0.2,1); }
    #mobile-drawer.open { transform: translateX(0); }
    #drawer-overlay { opacity: 0; pointer-events: none; transition: opacity 0.28s ease; }
    #drawer-overlay.open { opacity: 1; pointer-events: auto; }

    /* Desktop dropdown */
    .cat-dropdown { display: none; }
    .cat-trigger:focus-within .cat-dropdown,
    .cat-trigger:hover .cat-dropdown { display: block; }

    /* Progress bar */
    #progress-bar { position:fixed; top:0; left:0; height:3px; width:0%; background:linear-gradient(90deg,#f59e0b,#d97706); z-index:9999; transition:width 0.08s linear; }

    a { text-decoration: none !important; }
    .line-clamp-2 { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .line-clamp-3 { display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }

    /* Search overlay — desktop modal */
    #search-overlay { transition: opacity 0.18s ease; }
    #search-overlay.search-visible { opacity: 1; pointer-events: auto; }
    #search-overlay.search-hidden  { opacity: 0; pointer-events: none; }
    #search-modal-box { transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1), opacity 0.18s ease; }
    #search-overlay.search-hidden #search-modal-box { transform: translateY(-12px) scale(0.97); opacity: 0; }
    #search-overlay.search-visible #search-modal-box { transform: translateY(0) scale(1); opacity: 1; }

    /* Mobile search sheet */
    #mobile-search-sheet { transition: transform 0.32s cubic-bezier(0.4,0,0.2,1); transform: translateY(100%); }
    #mobile-search-sheet.sheet-open { transform: translateY(0); }
    #mobile-search-backdrop { opacity: 0; pointer-events: none; transition: opacity 0.28s ease; }
    #mobile-search-backdrop.sheet-open { opacity: 1; pointer-events: auto; }
  </style>
</head>
<body class="bg-[#f8f6f1] text-slate-900 min-h-screen flex flex-col">

<div id="progress-bar"></div>

<!-- Overlay -->
<div id="drawer-overlay" class="fixed inset-0 bg-black/50 z-40 md:hidden" onclick="closeDrawer()"></div>

<!-- ═══ MOBILE DRAWER ═══ -->
<nav id="mobile-drawer" class="fixed inset-y-0 left-0 w-72 bg-slate-900 z-50 md:hidden flex flex-col overflow-y-auto">
  <div class="flex items-center justify-between px-5 py-4 border-b border-slate-700 flex-shrink-0">
    <a href="/" class="flex items-center gap-2.5" onclick="closeDrawer()">
      <img src="/lex-research-logo.png" alt="Lex Research" class="w-8 h-8 object-contain brightness-0 invert" />
      <span class="text-white font-bold serif text-lg">Lex Research</span>
    </a>
    <button onclick="closeDrawer()" class="text-slate-400 hover:text-white p-1.5 rounded-lg transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <div class="flex-1 px-3 py-4 space-y-0.5">
    <a href="/" onclick="closeDrawer()" class={`flex items-center justify-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${path === '/' ? 'bg-slate-800 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      Home
    </a>

    <!-- All articles -->
    <a href="/articles" onclick="closeDrawer()" class={`flex items-center justify-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${path === '/articles' ? 'bg-amber-900/40 text-amber-300' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      All Articles
    </a>

    <!-- Browse all -->
    <a href="/categories" onclick="closeDrawer()" class={`flex items-center justify-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${path === '/categories' ? 'bg-amber-900/40 text-amber-300' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
      All Categories
    </a>

    <!-- Category groups in drawer -->
    {groups.map(group => (
      <div class="pt-3">
        <div class="pb-1 text-xs font-bold text-slate-500 uppercase tracking-wider text-center">{group.label}</div>
        {group.categories.map(cat => (
          <a href={`/category/${cat.slug}`} onclick="closeDrawer()"
             class={`flex items-center justify-center gap-2.5 px-3 py-2.5 rounded-lg text-sm transition-colors ${path === `/category/${cat.slug}` ? 'bg-slate-800 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-white'}`}>
            <span class="text-base flex-shrink-0">{cat.icon}</span>
            <span class="truncate">{cat.shortLabel}</span>
          </a>
        ))}
      </div>
    ))}

    <!-- About -->
    <div class="pt-3 border-t border-slate-800 mt-3">
      <a href="/about" onclick="closeDrawer()" class="flex items-center justify-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        About
      </a>
      <a href="/aims-and-scope" onclick="closeDrawer()" class={`flex items-center justify-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${path === '/aims-and-scope' ? 'bg-amber-900/40 text-amber-300' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        Aims &amp; Scope
      </a>
      <a href="/contact" onclick="closeDrawer()" class={`flex items-center justify-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${path === '/contact' ? 'bg-amber-900/40 text-amber-300' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        Contact
      </a>
    </div>
  </div>

  <div class="px-4 py-4 border-t border-slate-700 flex-shrink-0 space-y-2">
    <a href="/admin/login" onclick="closeDrawer()" class="flex items-center justify-center gap-2 w-full bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold text-sm px-4 py-2.5 rounded-xl transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
      Sign In
    </a>
  </div>
</nav>

<!-- ═══ HEADER ═══ -->
<header class="bg-white/95 backdrop-blur-sm border-b border-stone-200 sticky top-0 z-30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 sm:h-16 flex items-center justify-between gap-3">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 flex-shrink-0">
      <img src="/lex-research-logo.png" alt="Lex Research" class="w-9 h-9 sm:w-10 sm:h-10 object-contain" />
      <div>
        <div class="serif font-bold text-lg sm:text-xl text-slate-900 leading-none">Lex Research</div>
        <div class="text-xs text-stone-400 mt-0.5">International Legal Studies</div>
      </div>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-0.5">
      <a href="/" class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${path === '/' ? 'text-slate-900 bg-stone-100' : 'text-stone-600 hover:text-slate-900 hover:bg-stone-50'}`}>Home</a>

      <!-- Categories dropdown trigger -->
      <div class="cat-trigger relative">
        <a href="/categories" class={`flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium transition-colors ${path.startsWith('/category') || path === '/categories' ? 'text-slate-900 bg-stone-100' : 'text-stone-600 hover:text-slate-900 hover:bg-stone-50'}`}>
          Categories
          <svg class="w-3.5 h-3.5 opacity-50" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
        </a>

        <!-- Mega dropdown -->
        <div class="cat-dropdown absolute top-full left-1/2 -translate-x-1/2 mt-1 w-[680px] bg-white border border-stone-200 rounded-2xl shadow-xl z-50 p-5">
          <div class="grid grid-cols-3 gap-6">
            {groups.map(group => (
              <div>
                <div class="text-xs font-bold text-stone-400 uppercase tracking-wider mb-3">{group.label}</div>
                <div class="space-y-1">
                  {group.categories.map(cat => (
                    <a href={`/category/${cat.slug}`}
                       class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg hover:bg-stone-50 transition-colors group">
                      <span class="text-sm flex-shrink-0">{cat.icon}</span>
                      <span class="text-sm text-slate-700 group-hover:text-slate-900 leading-snug">{cat.shortLabel}</span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
          <div class="border-t border-stone-100 mt-4 pt-3">
            <a href="/categories" class="flex items-center justify-center gap-2 text-xs font-semibold text-stone-500 hover:text-slate-900 transition-colors py-1">
              View all {Object.keys(CATEGORIES).length} categories
              <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>

      <a href="/articles" class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${path === '/articles' ? 'text-slate-900 bg-stone-100' : 'text-stone-600 hover:text-slate-900 hover:bg-stone-50'}`}>Articles</a>
      <a href="/about" class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${path === '/about' ? 'text-slate-900 bg-stone-100' : 'text-stone-600 hover:text-slate-900 hover:bg-stone-50'}`}>About</a>
      <a href="/aims-and-scope" class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${path === '/aims-and-scope' ? 'text-slate-900 bg-stone-100' : 'text-stone-600 hover:text-slate-900 hover:bg-stone-50'}`}>Aims &amp; Scope</a>
      <a href="/contact" class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${path === '/contact' ? 'text-slate-900 bg-stone-100' : 'text-stone-600 hover:text-slate-900 hover:bg-stone-50'}`}>Contact</a>
    </nav>

    <div class="flex items-center gap-2">
      <!-- Mobile: eye-catching search pill -->
      <button onclick="openMobileSearch()" aria-label="Search"
        class="md:hidden flex items-center gap-1.5 bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-700 font-semibold text-sm px-3 py-1.5 rounded-full transition-all active:scale-95">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-4.35-4.35M17 11A6 6 0 115 11a6 6 0 0112 0z"/></svg>
        Search
      </button>
      <!-- Desktop: icon button -->
      <button onclick="openSearch()" aria-label="Search"
        class="hidden md:flex p-2 rounded-lg text-stone-600 hover:text-slate-900 hover:bg-stone-100 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 115 11a6 6 0 0112 0z"/></svg>
      </button>
      <div class="hidden md:flex items-center gap-2">
        <a href="/admin/login" class="flex items-center gap-1.5 text-xs font-semibold text-stone-600 hover:text-slate-900 border border-stone-200 hover:border-stone-400 px-3 py-1.5 rounded-lg transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
          Sign In
        </a>
      </div>
      <button onclick="openDrawer()" class="md:hidden p-2 rounded-lg text-stone-600 hover:text-slate-900 hover:bg-stone-100 transition-colors" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
</header>

<main class="flex-1"><slot /></main>

<!-- ═══ FOOTER ═══ -->
<footer class="bg-slate-900 text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-14">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 mb-6 sm:mb-10">
      <div class="col-span-2 sm:col-span-1">
        <div class="flex items-center gap-2.5 mb-3">
          <img src="/lex-research-logo.png" alt="Lex Research" class="w-8 h-8 object-contain brightness-0 invert" />
          <span class="serif text-white text-lg font-bold">Lex Research</span>
        </div>
        <p class="text-amber-400/80 italic text-xs mb-1">The World Through a Legal Lens</p>
        <p class="text-sm leading-relaxed max-w-xs">Open-access peer-reviewed scholarship in international law, world law, and comparative legal studies.</p>
        <div class="mt-4 text-xs text-slate-600">ISSN 2026-LEX · Volume 1 · 2026</div>
      </div>

      <div class="hidden sm:block">
        <div class="text-white font-semibold text-xs mb-3 uppercase tracking-wider">International Law</div>
        <ul class="space-y-2 text-sm">
          <li><a href="/category/international-law"       class="hover:text-emerald-400 transition-colors">🏛️ Int'l Law</a></li>
          <li><a href="/category/human-rights-law"        class="hover:text-rose-400    transition-colors">✊ Human Rights</a></li>
          <li><a href="/category/humanitarian-law"        class="hover:text-orange-400  transition-colors">🕊️ IHL</a></li>
          <li><a href="/category/international-criminal-law" class="hover:text-red-400  transition-colors">⚖️ Criminal Law</a></li>
          <li><a href="/category/international-trade-law" class="hover:text-blue-400    transition-colors">🤝 Trade Law</a></li>
        </ul>
      </div>

      <div>
        <div class="text-white font-semibold text-xs mb-3 uppercase tracking-wider">Specialised Fields</div>
        <ul class="space-y-2 text-sm">
          <li><a href="/category/maritime-law"                  class="hover:text-cyan-400   transition-colors">⚓ Maritime</a></li>
          <li><a href="/category/refugee-law"                   class="hover:text-teal-400   transition-colors">🏳️ Refugee Law</a></li>
