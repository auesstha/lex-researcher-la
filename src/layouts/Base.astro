<!-- ═══ DESKTOP SEARCH OVERLAY ═══ -->
<div id="search-overlay" class="hidden fixed inset-0 z-[60] search-hidden">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeSearch()"></div>
  <div id="search-modal-box" class="relative mx-auto mt-[12vh] w-full max-w-xl px-4">
    <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
      <form action="/articles" method="get" class="flex items-center px-4 py-3.5 gap-3 border-b border-stone-100">
        <svg class="w-5 h-5 text-stone-400 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 115 11a6 6 0 0112 0z"/></svg>
        <input id="search-input" type="search" name="q" placeholder="Search articles, authors, topics…" autocomplete="off"
          class="flex-1 text-slate-900 placeholder-stone-400 text-base focus:outline-none bg-transparent" />
        <button type="submit" class="px-3 py-1.5 bg-amber-500 hover:bg-amber-400 text-slate-900 font-semibold text-sm rounded-lg transition-colors flex-shrink-0">Search</button>
      </form>
      <div class="px-4 py-2.5 flex items-center justify-between">
        <span class="text-xs text-stone-400">Press <kbd class="px-1.5 py-0.5 bg-stone-100 rounded text-stone-500 font-mono">↵</kbd> to search</span>
        <span class="text-xs text-stone-400"><kbd class="px-1.5 py-0.5 bg-stone-100 rounded text-stone-500 font-mono">Esc</kbd> to close</span>
      </div>
    </div>
  </div>
</div>

<!-- ═══ MOBILE SEARCH SHEET ═══ -->
<div id="mobile-search-backdrop" class="fixed inset-0 z-[65] bg-black/60 backdrop-blur-sm md:hidden" onclick="closeMobileSearch()"></div>
<div id="mobile-search-sheet" class="fixed bottom-0 inset-x-0 z-[70] bg-white rounded-t-3xl shadow-2xl md:hidden" style="max-height:90vh;overflow-y:auto;">
  <!-- Drag handle -->
  <div class="flex justify-center pt-3 pb-1">
    <div class="w-10 h-1 bg-stone-200 rounded-full"></div>
  </div>
  <!-- Header row -->
  <div class="flex items-center justify-between px-5 pt-2 pb-3">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 bg-amber-100 rounded-xl flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-4.35-4.35M17 11A6 6 0 115 11a6 6 0 0112 0z"/></svg>
      </div>
      <span class="font-bold text-slate-900 text-base serif">Search Lex Research</span>
    </div>
    <button onclick="closeMobileSearch()" class="p-1.5 rounded-xl bg-stone-100 text-stone-500 hover:bg-stone-200 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>
  <!-- Search input -->
  <form action="/articles" method="get" class="px-5 pb-4" id="mobile-search-form">
    <div class="flex gap-2">
      <div class="relative flex-1">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400 pointer-events-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 115 11a6 6 0 0112 0z"/></svg>
        <input id="mobile-search-input" type="search" name="q" autocomplete="off"
          placeholder="Search articles, authors…"
          class="w-full pl-10 pr-4 py-3 bg-stone-50 border-2 border-stone-200 focus:border-amber-400 focus:bg-white rounded-xl text-slate-900 placeholder-stone-400 text-sm focus:outline-none transition-colors" />
      </div>
      <button type="submit"
        class="px-4 py-3 bg-amber-500 hover:bg-amber-400 active:bg-amber-600 text-slate-900 font-bold text-sm rounded-xl transition-colors flex-shrink-0 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-4.35-4.35M17 11A6 6 0 115 11a6 6 0 0112 0z"/></svg>
        Go
      </button>
    </div>
  </form>
  <!-- Popular topics -->
  <div class="px-5 pb-4">
    <p class="text-xs font-bold text-stone-400 uppercase tracking-wider mb-3">Popular Topics</p>
    <div class="flex flex-wrap gap-2">
      {[
        { label: '🏛️ Int\'l Law',    q: 'international law' },
        { label: '✊ Human Rights',   q: 'human rights' },
        { label: '🕊️ IHL',           q: 'humanitarian law' },
        { label: '⚖️ Criminal Law',  q: 'criminal law' },
        { label: '🌿 Environmental', q: 'environmental law' },
        { label: '⚓ Maritime',       q: 'maritime law' },
        { label: '🤝 Trade Law',      q: 'trade law' },
        { label: '🚀 Air & Space',    q: 'air space law' },
      ].map(chip => (
        <a href={`/articles?q=${encodeURIComponent(chip.q)}`}
           onclick="closeMobileSearch()"
           class="inline-flex items-center px-3 py-1.5 bg-stone-50 hover:bg-amber-50 border border-stone-200 hover:border-amber-300 text-stone-700 hover:text-amber-800 text-xs font-medium rounded-full transition-all active:scale-95">
          {chip.label}
        </a>
      ))}
    </div>
  </div>
  <!-- Quick links -->
  <div class="px-5 pb-6 border-t border-stone-100 pt-4">
    <p class="text-xs font-bold text-stone-400 uppercase tracking-wider mb-3">Quick Links</p>
    <div class="grid grid-cols-2 gap-2">
      <a href="/articles" onclick="closeMobileSearch()" class="flex items-center gap-2.5 px-3 py-2.5 bg-stone-50 hover:bg-stone-100 rounded-xl transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span class="text-sm font-medium text-slate-700">All Articles</span>
      </a>
      <a href="/categories" onclick="closeMobileSearch()" class="flex items-center gap-2.5 px-3 py-2.5 bg-stone-50 hover:bg-stone-100 rounded-xl transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
        <span class="text-sm font-medium text-slate-700">Categories</span>
      </a>
    </div>
  </div>
</div>

<script>
  function openDrawer() {
    document.getElementById('mobile-drawer')?.classList.add('open');
    document.getElementById('drawer-overlay')?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    document.getElementById('mobile-drawer')?.classList.remove('open');
    document.getElementById('drawer-overlay')?.classList.remove('open');
    document.body.style.overflow = '';
  }
  (window as any).openDrawer = openDrawer;
  (window as any).closeDrawer = closeDrawer;

  // ── Desktop search ──────────────────────────────────────────────
  function openSearch() {
    const el = document.getElementById('search-overlay');
    if (!el) return;
    el.classList.remove('hidden');
    requestAnimationFrame(() => {
      el.classList.remove('search-hidden');
      el.classList.add('search-visible');
    });
    setTimeout(() => (document.getElementById('search-input') as HTMLInputElement)?.focus(), 80);
    document.body.style.overflow = 'hidden';
  }
  function closeSearch() {
    const el = document.getElementById('search-overlay');
    if (!el) return;
    el.classList.remove('search-visible');
    el.classList.add('search-hidden');
    setTimeout(() => el.classList.add('hidden'), 200);
    document.body.style.overflow = '';
  }
  (window as any).openSearch = openSearch;
  (window as any).closeSearch = closeSearch;

  // ── Mobile search sheet ─────────────────────────────────────────
  function openMobileSearch() {
    document.getElementById('mobile-search-sheet')?.classList.add('sheet-open');
    document.getElementById('mobile-search-backdrop')?.classList.add('sheet-open');
    document.body.style.overflow = 'hidden';
    setTimeout(() => (document.getElementById('mobile-search-input') as HTMLInputElement)?.focus(), 200);
  }
  function closeMobileSearch() {
    document.getElementById('mobile-search-sheet')?.classList.remove('sheet-open');
    document.getElementById('mobile-search-backdrop')?.classList.remove('sheet-open');
    document.body.style.overflow = '';
  }
  (window as any).openMobileSearch = openMobileSearch;
  (window as any).closeMobileSearch = closeMobileSearch;

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { closeSearch(); closeMobileSearch(); }
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || e.key === '/') {
      const tag = (e.target as HTMLElement).tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      e.preventDefault();
      if (window.innerWidth < 768) openMobileSearch(); else openSearch();
    }
  });

  window.addEventListener('scroll', () => {
    const bar = document.getElementById('progress-bar');
    if (!bar) return;
    const total = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.width = total > 0 ? (window.scrollY / total * 100) + '%' : '0%';
  }, { passive: true });
</script>

</body>
</html>
