          </div>

        </div>

        <!-- expertise chips -->
        <div class="mt-6 pt-6 border-t border-slate-700/60 flex flex-wrap justify-center sm:justify-start gap-2">
          <span class="text-xs text-slate-500 font-medium self-center mr-1">Expertise:</span>
          {['International Law','River & Water Law','World Law','Human Rights','Constitutional Law'].map(area => (
            <span class="text-xs bg-slate-700/60 hover:bg-slate-700 text-slate-300 border border-slate-600/50 px-3 py-1 rounded-full transition-colors">{area}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Back link mobile -->
    <div class="mt-10 sm:hidden">
      <a href={`/category/${article.category}`} class="inline-flex items-center gap-2 text-sm font-medium text-stone-600 bg-white border border-stone-200 px-4 py-2.5 rounded-xl active:bg-stone-50">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        More {cat?.label} articles
      </a>
    </div>

  </div>

  <!-- Related articles -->
  {related.length > 0 && (
    <section class="border-t border-stone-200 bg-white py-10 sm:py-14">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <h2 class="serif text-lg sm:text-xl font-bold text-slate-900 mb-5 sm:mb-6">More in {cat?.label}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {related.map(r => (
            <a href={`/articles/${r.slug}`} class="group bg-stone-50 hover:bg-white border border-stone-200 hover:border-stone-300 rounded-2xl p-5 hover:shadow-md transition-all block">
              <div class="serif text-sm sm:text-base font-bold text-slate-900 group-hover:text-amber-800 leading-snug mb-2 transition-colors line-clamp-2">{r.title}</div>
              <div class="text-xs text-stone-500 line-clamp-2 leading-relaxed">{r.excerpt}</div>
              <div class="text-xs text-stone-400 mt-3 flex items-center gap-2">
                <span>{r.author}</span>
                <span>·</span>
                <time datetime={isoDate(r.publishedAt)}>{formatDate(r.publishedAt)}</time>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</Base>
