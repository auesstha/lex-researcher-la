---
import Base from '../../layouts/Base.astro';
import { getPublishedArticles, getArticleBySlug, CATEGORIES, getBadgeClass, getStripClass, getBannerClass } from '../../lib/articles';

const { slug } = Astro.params;
const article = await getArticleBySlug(Astro.locals, slug!);

if (!article || !article.published) {
  return Astro.redirect('/404');
}

// ── Markdown renderer ─────────────────────────────────────────────────────────
function inlineMd(text: string): string {
  return text
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .replace(
      /\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,
      '<a href="$2" target="_blank" rel="noopener noreferrer" ' +
      'class="text-amber-700 hover:text-amber-900 font-medium border-b border-amber-200 hover:border-amber-600 transition-colors">$1&nbsp;↗</a>'
    );
}

// ── Section image map ────────────────────────────────────────────────────────
// Keys are slug-ified h2 text; values come from the image jobs CSV r2_url.
// Add entries here as images are generated and uploaded.
type ArticleImages = Record<string, { src: string; alt: string }>;
const ARTICLE_IMAGES: Record<string, ArticleImages> = {
  'new-york-polymarket-lawsuit-laws-explained': {
    '__hero__': {
      src: '/images/articles/new-york-polymarket-lawsuit-laws-explained/new-york-polymarket-lawsuit-laws-explained-hero.jpg',
      alt: 'New York State courthouse at dawn — setting for the $4.6B Polymarket prediction market lawsuit',
    },
    'ny-penal-law-article-225-and-the-contest-of-chance-question': {
      src: '/images/articles/new-york-polymarket-lawsuit-laws-explained/ny-penal-law-225-gambling-statute.jpg',
      alt: 'Open New York Penal Law statute book showing Article 225 gambling provisions alongside scales of justice',
    },
    'the-circuit-split-third-circuit-ninth-circuit-and-sdny-torres': {
      src: '/images/articles/new-york-polymarket-lawsuit-laws-explained/circuit-split-federal-courts-map.jpg',
      alt: 'Federal Court of Appeals building representing the Third Circuit in the CEA preemption circuit split',
    },
    'what-comes-next-supreme-court-and-industry-impact': {
      src: '/images/articles/new-york-polymarket-lawsuit-laws-explained/supreme-court-prediction-markets.jpg',
      alt: 'United States Supreme Court building where certiorari on prediction market preemption is expected',
    },
  },
};

const sectionImages: ArticleImages = ARTICLE_IMAGES[article.slug] ?? {};

function slugify(text: string): string {
  return text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

type Block = { tag: 'h2' | 'h3' | 'p'; html: string; id?: string; faq?: boolean };
function parseContent(raw: string): Block[] {
  let inFaq = false;
  return raw
    .split('\n\n')
    .map(s => s.trim())
    .filter(Boolean)
    .map(block => {
      if (block.startsWith('## ')) {
        const text = block.slice(3).trim();
        inFaq = /frequently asked questions|faq/i.test(text);
        return { tag: 'h2' as const, html: inlineMd(text), id: slugify(text) };
      }
      if (block.startsWith('### ')) return { tag: 'h3' as const, html: inlineMd(block.slice(4).trim()), faq: inFaq };
      return { tag: 'p' as const, html: inlineMd(block), faq: inFaq };
    });
}

const blocks = parseContent(article.content);

// ── Helpers ───────────────────────────────────────────────────────────────────
const cat     = CATEGORIES[article.category];
const badge   = getBadgeClass(cat?.color);
const strip   = getStripClass(cat?.color);

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
function isoDate(iso: string) {
  return new Date(iso).toISOString();
}

const related = (await getPublishedArticles(Astro.locals))
  .filter(a => a.id !== article.id && a.category === article.category)
  .slice(0, 2);

// ── SEO / structured data ────────────────────────────────────────────────────
const canonicalURL = new URL(`/articles/${article.slug}`, Astro.url).href;
const siteURL      = new URL('/', Astro.url).href;

const heroImage = ARTICLE_IMAGES[article.slug]?.['__hero__'];
const firstSectionImage = Object.values(ARTICLE_IMAGES[article.slug] ?? {})[0];
const ogImage = heroImage?.src ?? firstSectionImage?.src ?? null;

// ── FAQ JSON-LD: extract ### headings + following paragraph ─────────────────
function extractFaqs(raw: string): Array<{ question: string; answer: string }> {
  const faqs: Array<{ question: string; answer: string }> = [];
  const lines = raw.split('\n\n').map(s => s.trim()).filter(Boolean);
  for (let i = 0; i < lines.length - 1; i++) {
    if (lines[i].startsWith('### ')) {
      faqs.push({ question: lines[i].slice(4).trim(), answer: lines[i + 1].trim() });
    }
  }
  return faqs;
}
const faqs = extractFaqs(article.content);
const faqJsonLd = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
} : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['ScholarlyArticle', 'NewsArticle'],
  headline: article.title,
  description: article.excerpt,
  url: canonicalURL,
  ...(ogImage ? { image: ogImage } : {}),
  datePublished: isoDate(article.publishedAt),
  dateModified:  isoDate(article.updatedAt),
  author: {
    '@type': 'Person',
    name: article.author,
    jobTitle: article.authorTitle,
    url: `${siteURL}lamia-akhter`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Lex Researcher',
    url: siteURL,
    logo: { '@type': 'ImageObject', url: `${siteURL}favicon.svg` },
  },
  keywords: article.tags.join(', '),
  about: {
    '@type': 'Thing',
    name: cat?.label ?? article.category,
    description: cat?.description ?? '',
  },
  isAccessibleForFree: true,
  isPartOf: {
    '@type': 'Periodical',
    name: 'Lex Researcher Journal',
    issn: '2026-LEX',
  },
};
---

<Base title={article.title} description={article.excerpt}>

  <!-- ── HEAD EXTRAS: canonical, OG, JSON-LD ───────────────────────────── -->
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type"        content="article" />
    <meta property="og:title"       content={`${article.title} — Lex Researcher`} />
    <meta property="og:description" content={article.excerpt} />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:site_name"   content="Lex Researcher" />
    <meta property="article:published_time" content={isoDate(article.publishedAt)} />
    <meta property="article:modified_time"  content={isoDate(article.updatedAt)} />
    <meta property="article:author"         content={article.author} />
    <meta property="article:tag"            content={article.tags.join(', ')} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="675" />}
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={article.title} />
    <meta name="twitter:description" content={article.excerpt} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  </Fragment>

  <!-- Sticky back bar on mobile -->
  <div class="sticky top-14 sm:top-16 z-20 bg-white/95 backdrop-blur-sm border-b border-stone-100 sm:hidden">
    <div class="px-4 py-2.5 flex items-center gap-3">
      <a href="javascript:history.back()" class="flex items-center gap-1.5 text-xs font-medium text-stone-500 active:text-stone-900">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Back
      </a>
      <span class="h-4 w-px bg-stone-200"></span>
      <span class={`text-xs font-semibold px-2 py-0.5 rounded-full uppercase tracking-wide ${badge}`}>
        {cat?.label}
      </span>
      <span class="text-xs text-stone-400 ml-auto">{article.readTime} min read</span>
    </div>
  </div>

  <!-- Article container -->
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-14">

    <!-- Desktop breadcrumb (also helps Google understand site structure) -->
    <nav class="hidden sm:flex items-center gap-2 text-sm text-stone-400 mb-10 flex-wrap" aria-label="Breadcrumb">
      <a href="/" class="hover:text-stone-700 transition-colors">Home</a>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <a href={`/category/${article.category}`} class="hover:text-stone-700 transition-colors">{cat?.label}</a>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-stone-600 truncate max-w-xs">{article.title}</span>
    </nav>

    <!-- BreadcrumbList JSON-LD for rich results -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
        { '@type': 'ListItem', position: 2, name: cat?.label, item: `${siteURL}category/${article.category}` },
        { '@type': 'ListItem', position: 3, name: article.title, item: canonicalURL },
      ],
    })} />

    <!-- Header -->
    <header class="mb-8 sm:mb-10">
      <span class={`hidden sm:inline-block text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wide mb-5 ${badge}`}>
        {cat?.icon} {cat?.label}
      </span>

      <h1 class="serif text-2xl sm:text-3xl md:text-4xl font-bold text-slate-900 mt-3 sm:mt-5 mb-4 sm:mb-5 leading-tight">
        {article.title}
      </h1>

      <p class="text-base sm:text-xl text-stone-500 leading-relaxed mb-6 sm:mb-8 font-light">
        {article.excerpt}
      </p>

      <!-- Author + meta strip -->
      <div class="flex items-center gap-4 sm:gap-6 bg-stone-50 rounded-2xl px-4 py-3 sm:px-5 sm:py-3.5 border border-stone-100">
        <div>
          <div class="font-semibold text-stone-400 uppercase tracking-wider text-[10px] mb-0.5">Published</div>
          <time datetime={isoDate(article.publishedAt)} class="text-stone-700 font-medium text-xs">{formatDate(article.publishedAt)}</time>
        </div>
        <div class="w-px h-6 bg-stone-200"></div>
        <div>
          <div class="font-semibold text-stone-400 uppercase tracking-wider text-[10px] mb-0.5">Read time</div>
          <div class="text-stone-700 font-medium text-xs">{article.readTime} min</div>
        </div>
      </div>
    </header>

    <!-- Color accent strip -->
    <div class={`h-0.5 w-16 rounded-full mb-8 ${strip}`}></div>

    <!-- Hero image (if available) -->
    {ARTICLE_IMAGES[article.slug]?.['__hero__'] && (
      <figure class="mb-10 rounded-2xl overflow-hidden border border-stone-200 shadow-sm">
        <img
          src={ARTICLE_IMAGES[article.slug]['__hero__'].src}
          alt={ARTICLE_IMAGES[article.slug]['__hero__'].alt}
          width="1200" height="675"
          class="w-full object-cover"
          loading="eager"
        />
      </figure>
    )}

    <!-- ── Article body ─────────────────────────────────────────────────── -->
    <article class="space-y-5">
      {blocks.map(block => {
        if (block.tag === 'h2') {
          const img = block.id ? sectionImages[block.id] : undefined;
          return (
            <>
              <h2 id={block.id} class="serif text-xl sm:text-2xl font-bold text-slate-900 mt-10 mb-3 pt-8 border-t border-stone-100 first:mt-0 first:pt-0 first:border-0" set:html={block.html} />
              {img && (
                <figure class="my-6 rounded-2xl overflow-hidden border border-stone-200 shadow-sm">
                  <img
                    src={img.src}
                    alt={img.alt}
                    width="1200" height="675"
                    class="w-full object-cover"
                    loading="lazy"
                  />
                  <figcaption class="text-xs text-stone-400 text-center px-4 py-2 bg-stone-50 border-t border-stone-100">
                    {img.alt}
                  </figcaption>
                </figure>
              )}
            </>
          );
        }
        if (block.tag === 'h3' && block.faq) return null;
        if (block.tag === 'p' && block.faq) return null;
        if (block.tag === 'h3') return (
          <h3 class="serif text-lg font-bold text-slate-800 mt-7 mb-2" set:html={block.html} />
        );
        return (
          <p class="text-slate-700 leading-8 text-base sm:text-lg" set:html={block.html} />
        );
      })}
    </article>

    <!-- ── FAQ Accordion ──────────────────────────────────────────────────── -->
    {faqs.length > 0 && (
      <section class="mt-12 sm:mt-16" id="faq">
        <!-- Header -->
        <div class="flex items-center gap-3 mb-6 sm:mb-8">
          <div class={`flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center text-white text-lg font-bold ${getBannerClass(cat?.color)}`}>?</div>
          <div>
            <h2 class="serif text-xl sm:text-2xl font-bold text-slate-900 leading-tight">Frequently Asked Questions</h2>
            <p class="text-xs text-stone-400 mt-0.5">{faqs.length} questions answered</p>
          </div>
        </div>

        <!-- Accordion items -->
        <div class="space-y-3">
          {faqs.map((faq, i) => (
            <details class="faq-item group rounded-2xl border border-stone-200 bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
              <summary class="flex items-start gap-4 px-5 py-4 sm:px-6 sm:py-5 cursor-pointer list-none select-none">
                <!-- Number badge -->
                <span class={`flex-shrink-0 mt-0.5 w-6 h-6 rounded-full text-white text-xs font-bold flex items-center justify-center ${getBannerClass(cat?.color)}`}>
                  {i + 1}
                </span>
                <!-- Question -->
                <span class="flex-1 serif text-sm sm:text-base font-semibold text-slate-800 group-open:text-slate-900 pr-2 leading-snug" set:html={faq.question} />
                <!-- Chevron -->
                <span class="flex-shrink-0 mt-0.5 w-5 h-5 text-stone-400 group-open:text-stone-700 transition-transform group-open:rotate-180">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                  </svg>
                </span>
              </summary>
              <!-- Answer -->
              <div class="px-5 pb-5 sm:px-6 sm:pb-6 pt-0">
                <div class="ml-10 pl-0.5 border-l-2 border-stone-100 pl-4">
                  <p class="text-stone-600 text-sm sm:text-base leading-7" set:html={faq.answer} />
                </div>
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <style>{`
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-item[open] {
        border-color: rgb(214 211 209);
        background: linear-gradient(to bottom, #fff 0%, #fafaf9 100%);
      }
      .faq-item[open] summary {
        border-bottom: 1px solid rgb(231 229 228);
      }
      details.faq-item > div {
        animation: faq-open 0.2s ease;
      }
      @keyframes faq-open {
        from { opacity: 0; transform: translateY(-6px); }
        to   { opacity: 1; transform: translateY(0); }
      }
    `}</style>

    <!-- Tags -->
    {article.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-10 sm:mt-12 pt-8 border-t border-stone-200">
        <span class="text-xs text-stone-400 font-medium mr-1 self-center">Tags:</span>
        {article.tags.map(tag => (
          <span class="text-xs bg-white text-stone-600 px-3 py-1.5 rounded-full border border-stone-200">{tag}</span>
        ))}
      </div>
    )}

    <!-- ── Author Bio Card ─────────────────────────────────────────────────── -->
    <div class="mt-10 sm:mt-14 rounded-3xl overflow-hidden border border-stone-200 shadow-sm author-card">
      <!-- Top gradient bar -->
      <div class="h-1.5 bg-gradient-to-r from-amber-500 via-amber-400 to-stone-300"></div>

      <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row sm:items-start gap-5 sm:gap-7">

          <!-- Avatar -->
          <div class="flex-shrink-0 flex sm:block justify-center">
            <div class="relative">
              <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center shadow-xl ring-4 ring-amber-500/20">
                <span class="text-slate-900 font-black text-4xl sm:text-5xl serif">L</span>
              </div>
              <!-- verified -->
              <div class="absolute -bottom-1.5 -right-1.5 w-7 h-7 bg-emerald-500 rounded-full border-3 border-slate-900 flex items-center justify-center shadow-md" style="border-width:3px">
                <svg class="w-3.5 h-3.5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </div>
            </div>
          </div>

          <!-- Info -->
          <div class="flex-1 text-center sm:text-left">
            <!-- label -->
            <p class="text-xs font-bold uppercase tracking-widest text-amber-400/80 mb-2">Written by</p>

            <!-- name + pills row -->
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-3">
              <h3 class="serif text-xl sm:text-2xl font-bold text-white leading-none">{article.author}</h3>
              <span class="inline-flex items-center gap-1 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-xs font-bold px-2.5 py-0.5 rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Verified Researcher
              </span>
            </div>

            <!-- role pills -->
            <div class="flex flex-wrap justify-center sm:justify-start gap-2 mb-4">
              <span class="inline-flex items-center gap-1.5 bg-amber-500/15 text-amber-300 border border-amber-500/25 text-xs font-semibold px-2.5 py-1 rounded-full">
                🎓 LLB Candidate
              </span>
              <span class="inline-flex items-center gap-1.5 bg-blue-500/15 text-blue-300 border border-blue-500/25 text-xs font-semibold px-2.5 py-1 rounded-full">
                💼 Legal Research Intern
              </span>
              <span class="inline-flex items-center gap-1.5 bg-purple-500/15 text-purple-300 border border-purple-500/25 text-xs font-semibold px-2.5 py-1 rounded-full">
                🔬 Journal Founder
              </span>
            </div>

            <!-- bio -->
            <p class="text-slate-400 text-sm leading-relaxed mb-5 max-w-lg mx-auto sm:mx-0">
              Founder of <span class="text-amber-400 font-semibold">Lex Researcher Journal</span>. LLB candidate passionate about international law, water rights, and legal accountability. Interning at a law chamber in Dhaka while conducting independent legal research.
            </p>

            <!-- stats row -->
            <div class="flex justify-center sm:justify-start gap-5 mb-5 text-center">
              <div>
                <div class="text-lg font-bold text-white">2</div>
                <div class="text-xs text-slate-500 uppercase tracking-wide">Articles</div>
              </div>
              <div class="w-px bg-slate-700 self-stretch"></div>
              <div>
                <div class="text-lg font-bold text-white">3</div>
                <div class="text-xs text-slate-500 uppercase tracking-wide">Focus Areas</div>
              </div>
              <div class="w-px bg-slate-700 self-stretch"></div>
              <div>
                <div class="text-lg font-bold text-white">Dhaka</div>
                <div class="text-xs text-slate-500 uppercase tracking-wide">Based in</div>
              </div>
            </div>

            <!-- social + profile buttons -->
            <div class="flex flex-wrap justify-center sm:justify-start items-center gap-3">
              <!-- Facebook -->
              <a href="https://facebook.com/lamiaakhter.law" target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-2 bg-[#1877F2] hover:bg-[#0d6fd8] active:bg-[#0a5ab8] text-white font-semibold px-4 py-2.5 rounded-xl text-sm transition-colors shadow-lg shadow-blue-500/20">
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                Facebook
              </a>
              <!-- Instagram -->
              <a href="https://instagram.com/lamiaakhter.law" target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-2 bg-gradient-to-r from-[#833ab4] via-[#fd1d1d] to-[#fcb045] hover:opacity-90 active:opacity-80 text-white font-semibold px-4 py-2.5 rounded-xl text-sm transition-opacity shadow-lg shadow-pink-500/20">
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
