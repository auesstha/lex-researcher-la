                LinkedIn
              </a>
              <!-- View Profile -->
              <a href="/lamia-akhter"
                 class="inline-flex items-center gap-2 border border-slate-600 hover:border-amber-500/50 hover:bg-slate-800 text-slate-300 hover:text-white px-4 py-2.5 rounded-xl text-sm transition-all">
                View Profile
                <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
