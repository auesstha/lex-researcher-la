              <a href="https://linkedin.com/in/lamia-akhter" target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-2 bg-[#0077B5] hover:bg-[#005f92] active:bg-[#004f7a] text-white font-semibold px-4 py-2.5 rounded-xl text-sm transition-colors shadow-lg shadow-sky-500/20">
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
