---
import Base from '../../layouts/Base.astro';
import { getPublishedArticles, CATEGORIES, getBadgeClass, getStripClass } from '../../lib/articles';

const all = (await getPublishedArticles(Astro.locals)).sort(
  (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime()
);

function fmt(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---
<Base title="All Articles — Lex Researcher">

<!-- Header -->
<section class="bg-slate-900 text-white">
  <div class="h-px w-full bg-gradient-to-r from-amber-500 via-amber-400 to-transparent"></div>
  <div class="max-w-5xl mx-auto px-5 py-10 md:py-14">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-amber-400 text-xs font-bold uppercase tracking-widest">Lex Researcher</span>
      <span class="w-px h-3 bg-slate-700"></span>
      <span class="text-slate-500 text-xs">Open-Access Journal</span>
    </div>
    <h1 class="font-serif text-3xl sm:text-4xl font-bold mb-3">All Articles</h1>
    <p class="text-slate-400 text-sm max-w-xl">
      {all.length} peer-reviewed article{all.length !== 1 ? 's' : ''} spanning international law, human rights, environmental law, and more.
    </p>
  </div>
</section>

<!-- Article list -->
<section class="max-w-5xl mx-auto px-5 py-10 md:py-14">

  {all.length === 0 ? (
    <div class="text-center py-20 text-stone-400">
      <div class="text-5xl mb-4">⚖️</div>
      <p class="font-serif text-xl">No articles published yet.</p>
    </div>
  ) : (
    <div class="space-y-5">
      {all.map((article, i) => {
        const cat = CATEGORIES[article.category];
        return (
          <a href={`/articles/${article.slug}`}
             class="group flex flex-col sm:flex-row gap-0 bg-white rounded-2xl border border-stone-200 hover:border-stone-300 hover:shadow-lg active:scale-[.995] transition-all overflow-hidden">

            <!-- colour strip (vertical on sm+, horizontal on mobile) -->
            <div class={`h-1 sm:h-auto sm:w-1.5 flex-shrink-0 ${getStripClass(cat?.color)}`}></div>

            <div class="flex flex-col sm:flex-row gap-4 p-5 flex-1 min-w-0">

              <!-- index number -->
              <div class="hidden sm:flex items-start pt-1">
                <span class="text-2xl font-bold text-stone-200 tabular-nums w-10 text-right leading-none select-none">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>

              <!-- main content -->
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class={`inline-flex items-center gap-1.5 border text-xs font-semibold px-2.5 py-0.5 rounded-full uppercase tracking-wide ${getBadgeClass(cat?.color)}`}>
                    {cat?.icon} {cat?.shortLabel}
                  </span>
                  <span class="text-xs text-stone-400">{fmt(article.publishedAt)}</span>
                  <span class="text-xs text-stone-300">·</span>
                  <span class="text-xs text-stone-400 flex items-center gap-1">
                    <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {article.readTime} min read
                  </span>
                </div>

                <h2 class="font-serif font-bold text-lg sm:text-xl text-slate-900 leading-snug mb-2 group-hover:text-amber-800 transition-colors">
                  {article.title}
                </h2>

                <p class="text-stone-500 text-sm leading-relaxed line-clamp-2 mb-3">
                  {article.excerpt}
                </p>

                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-full bg-slate-800 flex items-center justify-center text-white text-[10px] font-bold flex-shrink-0">
                      {article.author.charAt(0)}
                    </div>
                    <span class="text-xs font-medium text-slate-600">{article.author}</span>
                    {article.authorTitle && <span class="text-xs text-stone-400 hidden sm:inline">· {article.authorTitle}</span>}
                  </div>
                  <span class="text-xs font-semibold text-stone-400 group-hover:text-amber-700 flex items-center gap-1 transition-colors">
                    Read article
                    <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                  </span>
                </div>
              </div>

            </div>
          </a>
        );
      })}
    </div>
  )}

</section>

</Base>
