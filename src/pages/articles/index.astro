---
import Base from '../../layouts/Base.astro';
import { getPublishedArticles, CATEGORIES } from '../../lib/articles';
import { getApprovedAuthors } from '../../lib/auth';

const all = (await getPublishedArticles(Astro.locals)).sort(
  (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime()
);

const approvedAuthors = await getApprovedAuthors();
const authorUrlMap: Record<string, string> = Object.fromEntries(
  approvedAuthors.map(u => [u.display_name, `/author/${u.username}`])
);
authorUrlMap['Lamia Akhter'] = '/lamia-akhter';

const authorAvatarMap: Record<string, string> = Object.fromEntries(
  approvedAuthors.map(u => [u.display_name, u.avatar || ''])
);

function initials(name: string) {
  return name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
}
function fmt(iso: string) {
  return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

const BAR: Record<string, string> = {
  amber:'bg-amber-500', blue:'bg-blue-500', green:'bg-green-500', red:'bg-red-500',
  purple:'bg-purple-500', teal:'bg-teal-500', cyan:'bg-cyan-500', indigo:'bg-indigo-500',
  emerald:'bg-emerald-500', stone:'bg-stone-400',
};
const BADGE: Record<string, string> = {
  amber:'bg-amber-50 text-amber-700 border-amber-200',
  blue:'bg-blue-50 text-blue-700 border-blue-200',
  green:'bg-green-50 text-green-700 border-green-200',
  red:'bg-red-50 text-red-700 border-red-200',
  purple:'bg-purple-50 text-purple-700 border-purple-200',
  teal:'bg-teal-50 text-teal-700 border-teal-200',
  cyan:'bg-cyan-50 text-cyan-700 border-cyan-200',
  indigo:'bg-indigo-50 text-indigo-700 border-indigo-200',
  emerald:'bg-emerald-50 text-emerald-700 border-emerald-200',
  stone:'bg-stone-50 text-stone-600 border-stone-200',
};
---
<Base title="All Articles — Lex Researcher" keywords="law articles, legal research, international law, Lex Researcher">

<!-- Hero -->
<section class="bg-slate-900 text-white">
  <div class="h-0.5 bg-gradient-to-r from-amber-500 via-amber-400 to-transparent"></div>
  <div class="max-w-4xl mx-auto px-5 py-12 md:py-16">
    <p class="text-amber-400 text-xs font-bold uppercase tracking-widest mb-4">Lex Researcher · Open-Access Journal</p>
    <h1 class="font-serif text-4xl sm:text-5xl font-bold mb-3 leading-tight">All Articles</h1>
    <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
      {all.length} peer-reviewed article{all.length !== 1 ? 's' : ''} on international &amp; comparative law.
    </p>
  </div>
</section>

<!-- Articles -->
<div class="bg-stone-50 min-h-screen">
  <div class="max-w-4xl mx-auto px-4 sm:px-5 py-10 md:py-14">
    {all.length === 0 ? (
      <p class="text-center py-24 text-stone-400 font-serif text-xl">No articles published yet.</p>
    ) : (
      <div class="space-y-4">
        {all.map((article, i) => {
          const cat = CATEGORIES[article.category];
          const color = cat?.color ?? 'stone';
          const bar = BAR[color] ?? BAR.stone;
          const badge = BADGE[color] ?? BADGE.stone;
          const authorUrl = authorUrlMap[article.author];
          const avatar = authorAvatarMap[article.author] || '';
          return (
            <a href={`/articles/${article.slug}`}
               class="group block bg-white rounded-2xl border border-stone-200 hover:shadow-md transition-all duration-200 overflow-hidden">

              <!-- colour bar -->
              <div class={`h-1 ${bar}`}></div>

              <div class="p-5 sm:p-6">

                <!-- badge + date + read time -->
                <div class="flex flex-wrap items-center gap-2 mb-3">
                  <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full border uppercase tracking-wide ${badge}`}>
                    {cat?.shortLabel ?? article.category}
                  </span>
                  <span class="text-xs text-stone-400">{fmt(article.publishedAt)}</span>
                  <span class="text-xs text-stone-300">·</span>
                  <span class="text-xs text-stone-400">{article.readTime} min read</span>
                </div>

                <!-- title -->
                <h2 class="font-serif font-bold text-xl sm:text-2xl text-slate-900 leading-snug mb-2 group-hover:text-amber-800 transition-colors">
                  {article.title}
                </h2>

                <!-- excerpt -->
                <p class="text-stone-500 text-sm leading-relaxed line-clamp-2 mb-4">
                  {article.excerpt}
                </p>

                <!-- author row -->
                <div class="flex items-center justify-between gap-3 pt-4 border-t border-stone-100">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-8 h-8 rounded-full bg-slate-800 flex-shrink-0 overflow-hidden flex items-center justify-center ring-2 ring-stone-100">
                      {avatar
                        ? <img src={avatar} class="w-full h-full object-cover" alt={article.author} />
                        : <span class="text-white text-[10px] font-bold leading-none">{initials(article.author)}</span>
                      }
                    </div>
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-slate-800 leading-tight truncate">{article.author}</p>
                      {article.authorTitle && (
                        <p class="text-xs text-stone-400 leading-tight truncate">{article.authorTitle}</p>
                      )}
                    </div>
                  </div>
                  <span class="flex-shrink-0 flex items-center gap-1 text-xs font-semibold text-stone-400 group-hover:text-amber-700 transition-colors whitespace-nowrap">
                    Read article
                    <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                    </svg>
                  </span>
                </div>

              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</div>

</Base>
