---
import Base from '../layouts/Base.astro';
const lastUpdated = 'November 2026';
const effectiveDate = 'November 2026';
---
<Base
  title="Terms & Conditions — Lex Research International Law Journal"
  description="Terms and Conditions of Lex Research — an open-access international law journal. Governs the use of lexresearch.org, author submissions, content responsibility, open-access licensing, and limitation of liability."
  keywords="terms and conditions, terms of use, Lex Research, law journal, author submissions, content liability, open access, disclaimer">

  <!-- Header -->
  <div class="bg-slate-900 text-white">
    <div class="h-1 bg-gradient-to-r from-amber-500 via-amber-400 to-transparent"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
      <div class="flex items-center gap-2 text-amber-400 text-xs font-bold uppercase tracking-widest mb-5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
        Lex Research · Legal Documentation
      </div>
      <h1 class="serif text-3xl sm:text-5xl font-bold mb-4 leading-tight">Terms &amp; Conditions</h1>
      <p class="text-slate-400 text-sm leading-relaxed max-w-2xl">
        These Terms and Conditions govern access to and use of <strong class="text-slate-300">lexresearch.org</strong> and all services provided by Lex Research International Law Journal. Please read this document carefully before using the Journal's platform.
      </p>
      <div class="flex flex-wrap gap-6 mt-6 text-xs text-slate-500 font-mono">
        <span>Effective Date: {effectiveDate}</span>
        <span>·</span>
        <span>Last Updated: {lastUpdated}</span>
        <span>·</span>
        <span>Version 1.0</span>
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-16">

    <!-- Document meta panel -->
    <div class="bg-stone-50 border border-stone-200 rounded-2xl p-5 sm:p-7 mb-12 grid sm:grid-cols-3 gap-4 text-sm">
      <div class="border-b sm:border-b-0 sm:border-r border-stone-200 pb-4 sm:pb-0 sm:pr-4">
        <div class="text-xs font-bold uppercase tracking-wider text-stone-400 mb-1">Issued By</div>
        <div class="font-semibold text-slate-800">Lex Research Journal</div>
        <div class="text-slate-500 text-xs mt-0.5">Founded by Lamia Akhter</div>
      </div>
      <div class="border-b sm:border-b-0 sm:border-r border-stone-200 pb-4 sm:pb-0 sm:pr-4">
        <div class="text-xs font-bold uppercase tracking-wider text-stone-400 mb-1">Scope</div>
        <div class="font-semibold text-slate-800">All users of lexresearch.org</div>
        <div class="text-slate-500 text-xs mt-0.5">Visitors · Authors · Contributors</div>
      </div>
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-stone-400 mb-1">Governing Law</div>
        <div class="font-semibold text-slate-800">Laws of Bangladesh</div>
        <div class="text-slate-500 text-xs mt-0.5">Courts of Bangladesh have jurisdiction</div>
      </div>
    </div>

    <!-- Preamble -->
    <div class="border-l-4 border-amber-400 pl-5 sm:pl-6 mb-12">
      <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
        By accessing or using <strong>lexresearch.org</strong>, you agree to be bound by these Terms and Conditions in their entirety. If you do not accept these Terms, you must discontinue your use of the Journal's platform immediately. These Terms constitute a legally binding agreement between you and Lex Research International Law Journal.
      </p>
    </div>

    <div class="space-y-12">

      <!-- Article I -->
      <article>
        <div class="flex items-baseline gap-4 mb-4 pb-3 border-b-2 border-slate-900">
          <span class="text-xs font-bold uppercase tracking-widest text-amber-600 flex-shrink-0">Article I</span>
          <h2 class="serif text-xl sm:text-2xl font-bold text-slate-900">The Journal</h2>
        </div>
        <div class="space-y-3 text-sm sm:text-base text-slate-700 leading-relaxed">
          <p><strong class="text-slate-900">1.1</strong> &nbsp;Lex Research International Law Journal ("the Journal") is an open-access academic publication dedicated to the advancement of scholarship in international law, human rights law, international humanitarian law, comparative law, and related legal disciplines. The Journal is founded and operated by <a href="/lamia-akhter" class="text-amber-700 hover:text-amber-900 font-medium transition-colors">Lamia Akhter</a>.</p>
          <p><strong class="text-slate-900">1.2</strong> &nbsp;All content published on the Journal's platform is made freely accessible to readers worldwide without subscription, paywall, or access fee, consistent with the Journal's open-access mission.</p>
          <p><strong class="text-slate-900">1.3</strong> &nbsp;The Journal publishes peer-reviewed scholarly articles. The views, opinions, findings, and conclusions expressed in any published article are those of the author or authors alone. They do not represent, and shall not be attributed to, the Journal, its editorial board, its founder, or its staff.</p>
        </div>
      </article>

      <!-- Article II — Academic Disclaimer -->
      <article>
        <div class="flex items-baseline gap-4 mb-4 pb-3 border-b-2 border-slate-900">
          <span class="text-xs font-bold uppercase tracking-widest text-amber-600 flex-shrink-0">Article II</span>
          <h2 class="serif text-xl sm:text-2xl font-bold text-slate-900">Academic Disclaimer — Not Legal Advice</h2>
        </div>
        <div class="bg-slate-900 text-white rounded-2xl p-5 sm:p-7 mb-4">
          <div class="flex gap-3 items-start">
            <svg class="w-5 h-5 text-amber-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
              <strong class="text-white">All content published on Lex Research is strictly for academic, informational, and scholarly reference purposes only.</strong> Nothing contained on this platform constitutes legal advice, legal opinion, or a solicitation of professional legal services. Readers requiring advice on specific legal matters must consult a qualified legal practitioner in the relevant jurisdiction.
            </p>
          </div>
        </div>
        <div class="space-y-3 text-sm sm:text-base text-slate-700 leading-relaxed">
          <p><strong class="text-slate-900">2.1</strong> &nbsp;The Journal expressly disclaims any liability arising from the reliance by any person upon any content published on this platform as legal advice or as a substitute for qualified professional legal counsel.</p>
          <p><strong class="text-slate-900">2.2</strong> &nbsp;The law is subject to continuous change through legislative amendment, judicial interpretation, and executive action. The Journal does not warrant that any published article accurately reflects the current state of the law in any jurisdiction at the time of reading.</p>
        </div>
      </article>

      <!-- Article III — Content Responsibility -->
      <article>
        <div class="flex items-baseline gap-4 mb-4 pb-3 border-b-2 border-slate-900">
          <span class="text-xs font-bold uppercase tracking-widest text-amber-600 flex-shrink-0">Article III</span>
          <h2 class="serif text-xl sm:text-2xl font-bold text-slate-900">Responsibility for Submitted Content</h2>
        </div>
        <div class="space-y-4 text-sm sm:text-base text-slate-700 leading-relaxed">
          <p><strong class="text-slate-900">3.1 &nbsp;Sole Responsibility of the Author.</strong> &nbsp;All manuscripts, articles, abstracts, author profiles, commentary, and any other material submitted to the Journal by authors, contributors, or any third party are submitted voluntarily by those individuals. <strong class="text-slate-900">The submitting author bears sole and exclusive responsibility for all content they submit.</strong> This includes but is not limited to responsibility for:</p>
          <ul class="space-y-2 ml-6">
            {[
              'The accuracy, completeness, and truthfulness of all factual assertions and legal analysis contained in the submission',
              'Ensuring the submission is original work and does not infringe the intellectual property rights of any third party',
              'Ensuring the submission does not contain defamatory, unlawful, misleading, or otherwise objectionable material',
              'Ensuring all citations, references, and attributed quotations are accurate and correctly sourced',
              'Compliance with all applicable laws and professional ethical obligations governing the content of the submission',
            ].map(item => (
              <li class="flex gap-3 text-slate-600">
                <span class="text-amber-500 font-bold flex-shrink-0 mt-0.5">§</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mt-2">
            <p class="text-sm sm:text-base text-amber-900 leading-relaxed font-medium">
              The Journal is a publishing platform. The act of publishing a submitted article does not constitute the Journal's endorsement, verification, adoption, or approval of any view, claim, finding, or legal position expressed therein. The Journal accepts no responsibility and shall not be held liable for the content of any article, manuscript, or material submitted and published on its platform.
            </p>
          </div>

          <p><strong class="text-slate-900">3.2 &nbsp;No Pre-Publication Verification.</strong> &nbsp;While the Journal operates a peer-review process aimed at maintaining scholarly standards, such review is academic in nature and does not constitute legal verification of any content. The Journal does not and cannot independently verify every factual claim, citation, or legal proposition contained within submitted manuscripts. The peer-review process does not transfer responsibility for the content from the author to the Journal.</p>

          <p><strong class="text-slate-900">3.3 &nbsp;Indemnification by Authors and Contributors.</strong> &nbsp;By submitting any content to the Journal, the submitting author agrees to indemnify, defend, and hold harmless Lex Research, its founder, editors, and staff from and against any and all claims, damages, losses, costs, and liabilities (including reasonable legal fees) arising out of or related to:</p>
          <ul class="space-y-2 ml-6">
            {[
              'Any breach of the representations and warranties set out in Article IV of these Terms',
              'Any claim by a third party that the submitted content infringes their intellectual property rights',
              'Any claim arising from the inaccuracy, falsity, or unlawfulness of any content contained in the submission',
              'Any defamation or reputational harm caused by the published content',
            ].map(item => (
              <li class="flex gap-3 text-slate-600">
                <span class="text-amber-500 font-bold flex-shrink-0 mt-0.5">§</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <p><strong class="text-slate-900">3.4 &nbsp;Right of Withdrawal.</strong> &nbsp;The Journal reserves the right, in its sole discretion, to withdraw, remove, or decline to publish any content where it reasonably believes such content may be unlawful, defamatory, inaccurate, or contrary to the Journal's editorial standards. Such withdrawal shall not give rise to any liability on the part of the Journal towards the submitting author.</p>
        </div>
      </article>

      <!-- Article IV -->
      <article>
        <div class="flex items-baseline gap-4 mb-4 pb-3 border-b-2 border-slate-900">
          <span class="text-xs font-bold uppercase tracking-widest text-amber-600 flex-shrink-0">Article IV</span>
          <h2 class="serif text-xl sm:text-2xl font-bold text-slate-900">Author Warranties and Representations</h2>
        </div>
        <div class="space-y-3 text-sm sm:text-base text-slate-700 leading-relaxed">
          <p><strong class="text-slate-900">4.1</strong> &nbsp;By submitting a manuscript or any content to the Journal, the author represents and warrants that:</p>
          <div class="space-y-2 mt-1">
            {[
              ['Originality', 'The work is the author\'s own original research and has not been previously published, in whole or in part, in any other journal, book, or publication, nor is it under simultaneous review by any other publication.'],
              ['Absence of Plagiarism', 'The submission does not reproduce, paraphrase, or otherwise incorporate any third-party material without proper attribution, and does not constitute plagiarism.'],
              ['Accuracy', 'All facts, data, citations, quotations, and legal propositions contained in the submission are, to the best of the author\'s knowledge and belief, accurate and correctly attributed.'],
              ['Lawfulness', 'The submission does not contain material that is defamatory, discriminatory, obscene, unlawful, or in violation of any applicable law or regulation.'],
              ['Publication Licence', 'The author grants the Journal a non-exclusive, irrevocable, royalty-free licence to publish, display, reproduce, and distribute the work on the Journal\'s platform and any associated channels, in perpetuity.'],
              ['Retention of Copyright', 'The author retains copyright in the submitted work. The Journal does not claim ownership of any submitted article or manuscript.'],
            ].map(([title, desc]) => (
              <div class="flex gap-4 border border-stone-200 rounded-xl p-4 bg-stone-50">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 flex-shrink-0 mt-2"></span>
                <div>
                  <span class="font-semibold text-slate-800 text-sm">{title}: </span>
                  <span class="text-slate-600 text-sm leading-relaxed">{desc}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </article>

      <!-- Article V -->
      <article>
        <div class="flex items-baseline gap-4 mb-4 pb-3 border-b-2 border-slate-900">
          <span class="text-xs font-bold uppercase tracking-widest text-amber-600 flex-shrink-0">Article V</span>
          <h2 class="serif text-xl sm:text-2xl font-bold text-slate-900">Intellectual Property and Open-Access Licence</h2>
        </div>
        <div class="space-y-3 text-sm sm:text-base text-slate-700 leading-relaxed">
          <p><strong class="text-slate-900">5.1</strong> &nbsp;Published articles may be read, shared, downloaded, and cited for non-commercial academic and educational purposes, provided that:</p>
          <ul class="space-y-2 ml-6">
            {[
              'Full and accurate credit is given to the named author(s) and to Lex Research International Law Journal',
              'The original URL or permanent link to the article on lexresearch.org is included in any citation or reference',
              'The content is not altered, abridged, or misrepresented in any way',
              'The content is not reproduced for commercial gain without the prior written consent of the author and the Journal',
            ].map(item => (
              <li class="flex gap-3 text-slate-600">
                <span class="text-amber-500 font-bold flex-shrink-0 mt-0.5">§</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p><strong class="text-slate-900">5.2</strong> &nbsp;The name "Lex Research", the Journal's logo, visual identity, site design, editorial content, and all non-article materials published on the platform remain the exclusive intellectual property of Lex Research and may not be reproduced, adapted, or used in any form without prior written permission.</p>
        </div>
      </article>

      <!-- Article VI -->
      <article>
        <div class="flex items-baseline gap-4 mb-4 pb-3 border-b-2 border-slate-900">
          <span class="text-xs font-bold uppercase tracking-widest text-amber-600 flex-shrink-0">Article VI</span>
          <h2 class="serif text-xl sm:text-2xl font-bold text-slate-900">Limitation of Liability</h2>
        </div>
        <div class="space-y-3 text-sm sm:text-base text-slate-700 leading-relaxed">
          <p><strong class="text-slate-900">6.1</strong> &nbsp;To the fullest extent permitted by applicable law, the Journal, its founder, editors, and staff shall not be liable for any loss or damage — whether direct, indirect, incidental, consequential, or otherwise — arising from:</p>
          <ul class="space-y-2 ml-6">
            {[
              'Reliance upon any content, article, analysis, or information published on the platform',
              'Any errors, omissions, inaccuracies, or incompleteness in published content',
              'Temporary or permanent unavailability of the platform',
              'Any content submitted by authors or third parties and published on the Journal\'s platform',
              'Any decision made or action taken by any person in reliance upon material found on this platform',
            ].map(item => (
              <li class="flex gap-3 text-slate-600">
                <span class="text-amber-500 font-bold flex-shrink-0 mt-0.5">§</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p><strong class="text-slate-900">6.2</strong> &nbsp;The Journal's platform is provided on an "as is" and "as available" basis without warranties of any kind, whether express or implied, including but not limited to implied warranties of fitness for a particular purpose, merchantability, or non-infringement.</p>
          <p><strong class="text-slate-900">6.3</strong> &nbsp;The Journal shall bear no liability whatsoever in respect of content submitted by authors or third parties. Any legal claim arising from published content shall be directed exclusively to the author of that content, who bears sole responsibility therefor in accordance with Article III of these Terms.</p>
        </div>
      </article>

      <!-- Article VII -->
      <article>
        <div class="flex items-baseline gap-4 mb-4 pb-3 border-b-2 border-slate-900">
          <span class="text-xs font-bold uppercase tracking-widest text-amber-600 flex-shrink-0">Article VII</span>
          <h2 class="serif text-xl sm:text-2xl font-bold text-slate-900">User Accounts</h2>
        </div>
        <div class="space-y-3 text-sm sm:text-base text-slate-700 leading-relaxed">
          <p><strong class="text-slate-900">7.1</strong> &nbsp;Author accounts are available to approved contributors. Upon registration, the account holder agrees to provide accurate and complete information and to maintain the confidentiality of their account credentials.</p>
          <p><strong class="text-slate-900">7.2</strong> &nbsp;The Journal reserves the right to suspend or close any account where, in its reasonable assessment, the account has been used in a manner inconsistent with these Terms or contrary to the Journal's editorial standards and academic integrity policies.</p>
          <p><strong class="text-slate-900">7.3</strong> &nbsp;The account holder remains solely responsible for all activity conducted through their account.</p>
        </div>
      </article>

      <!-- Article VIII -->
      <article>
        <div class="flex items-baseline gap-4 mb-4 pb-3 border-b-2 border-slate-900">
          <span class="text-xs font-bold uppercase tracking-widest text-amber-600 flex-shrink-0">Article VIII</span>
          <h2 class="serif text-xl sm:text-2xl font-bold text-slate-900">External Links</h2>
        </div>
        <div class="space-y-3 text-sm sm:text-base text-slate-700 leading-relaxed">
          <p><strong class="text-slate-900">8.1</strong> &nbsp;Articles and pages on this platform may include hyperlinks to external websites, legislation databases, court repositories, or third-party resources. Such links are provided for reference and convenience only. The Journal exercises no control over external websites and accepts no responsibility for their content, accuracy, availability, or data practices.</p>
          <p><strong class="text-slate-900">8.2</strong> &nbsp;The inclusion of a link to an external resource does not constitute the Journal's endorsement of that resource or its content.</p>
        </div>
      </article>

      <!-- Article IX -->
      <article>
        <div class="flex items-baseline gap-4 mb-4 pb-3 border-b-2 border-slate-900">
          <span class="text-xs font-bold uppercase tracking-widest text-amber-600 flex-shrink-0">Article IX</span>
          <h2 class="serif text-xl sm:text-2xl font-bold text-slate-900">Governing Law and Jurisdiction</h2>
        </div>
        <div class="space-y-3 text-sm sm:text-base text-slate-700 leading-relaxed">
          <p><strong class="text-slate-900">9.1</strong> &nbsp;These Terms and Conditions are governed by and construed in accordance with the laws of the People's Republic of Bangladesh.</p>
          <p><strong class="text-slate-900">9.2</strong> &nbsp;Any dispute arising out of or in connection with these Terms — including any question regarding their existence, validity, or termination — shall be subject to the exclusive jurisdiction of the competent courts of Bangladesh, without prejudice to any mandatory rights available to users under the law of their country of residence.</p>
        </div>
      </article>

      <!-- Article X -->
      <article>
        <div class="flex items-baseline gap-4 mb-4 pb-3 border-b-2 border-slate-900">
          <span class="text-xs font-bold uppercase tracking-widest text-amber-600 flex-shrink-0">Article X</span>
          <h2 class="serif text-xl sm:text-2xl font-bold text-slate-900">Amendments to These Terms</h2>
        </div>
        <div class="space-y-3 text-sm sm:text-base text-slate-700 leading-relaxed">
          <p><strong class="text-slate-900">10.1</strong> &nbsp;The Journal reserves the right to amend these Terms and Conditions at any time. Amendments take effect upon publication on this page. The version date appearing at the head of this document will be updated accordingly.</p>
          <p><strong class="text-slate-900">10.2</strong> &nbsp;Continued use of the Journal's platform following the publication of any amendment constitutes acceptance of the revised Terms. Users are encouraged to review this page periodically.</p>
        </div>
      </article>

    </div>

    <!-- Footer panel -->
    <div class="mt-14 bg-slate-900 text-white rounded-2xl p-6 sm:p-8">
      <div class="flex flex-col sm:flex-row gap-6 items-start sm:items-center justify-between">
        <div>
          <div class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-1">Lex Research International Law Journal</div>
          <p class="text-slate-400 text-sm">For all legal and editorial enquiries: <a href="mailto:info@lexresearch.org" class="text-amber-400 hover:text-amber-300 transition-colors font-medium">info@lexresearch.org</a></p>
          <p class="text-slate-600 text-xs mt-2">© 2026 Lex Research Journal · All rights reserved</p>
        </div>
        <a href="/privacy-policy" class="flex-shrink-0 inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold text-sm px-5 py-2.5 rounded-xl transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Privacy Policy
        </a>
      </div>
    </div>

  </div>
</Base>
