---
import Base from '../../layouts/Base.astro';
import { getUserByUsername, getSession } from '../../lib/auth';
import { getPublishedArticles, CATEGORIES, getBadgeClass } from '../../lib/articles';
import type { CategorySlug } from '../../lib/articles';

// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';
const kv = (cfEnv as any).SESSION;

const { username } = Astro.params;
const author = await getUserByUsername(username!);

if (!author || author.status !== 'approved') {
  return Astro.redirect('/404');
}

// Check if the logged-in user is viewing their own profile
const session = await getSession(Astro.request, kv);
const isOwnProfile = session != null && String(session.userId) === String(author.id);

const allArticles = await getPublishedArticles(Astro.locals);
const articles = allArticles
  .filter(a => a.author === author.display_name)
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());

function fmt(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}

const initials = author.display_name.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
---
<Base
  title={`${author.display_name} — Legal Researcher`}
  description={author.bio || `${author.display_name} is a legal researcher and author at Lex Researcher Journal.`}
  keywords={`${author.display_name}, legal researcher, ${author.specialisation || 'international law'}, Lex Researcher`}
>

<!-- ═══ HERO ═══ -->
<section class="bg-slate-900 text-white">
  <div class="h-0.5 bg-gradient-to-r from-amber-500 via-amber-400 to-transparent"></div>

  <div class="max-w-5xl mx-auto px-5 py-12 md:py-20">
    <div class="flex flex-col md:flex-row md:items-center md:gap-12">

      <!-- Avatar -->
      <div class="flex-shrink-0 mb-8 md:mb-0 flex md:block justify-center">
        <div class="relative">
          <div class="w-32 h-32 md:w-44 md:h-44 rounded-3xl overflow-hidden shadow-2xl bg-amber-500 flex items-center justify-center">
            <span class="text-slate-900 font-black text-5xl md:text-6xl" style="font-family:'Playfair Display',Georgia,serif">{initials}</span>
          </div>
          <div class="absolute -bottom-2 -right-2 w-8 h-8 bg-emerald-500 rounded-full border-4 border-slate-900 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
          </div>
        </div>
      </div>

      <!-- Info -->
      <div class="text-center md:text-left">

        {author.title && (
          <div class="flex flex-wrap justify-center md:justify-start gap-2 mb-5">
            {author.title.split('&').map((t: string) => (
              <span class="inline-flex items-center gap-1.5 bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wide">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                {t.trim()}
              </span>
            ))}
          </div>
        )}

        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-3 leading-tight">
          {author.display_name}
        </h1>

        {author.bio && (
          <p class="text-slate-400 text-base sm:text-lg mb-6 max-w-xl mx-auto md:mx-0 leading-relaxed">
            {author.bio}
          </p>
        )}

        <!-- Stats -->
        <div class="flex flex-wrap justify-center md:justify-start gap-4 mb-7">
          <div class="text-center">
            <div class="text-2xl font-bold text-white">{articles.length}</div>
            <div class="text-xs text-slate-500 uppercase tracking-wide">Articles</div>
          </div>
          {author.specialisation && (
            <>
              <div class="w-px bg-slate-700 self-stretch"></div>
              <div class="text-center">
                <div class="text-sm font-bold text-white leading-tight max-w-[120px]">{author.specialisation.split(',')[0].trim()}</div>
                <div class="text-xs text-slate-500 uppercase tracking-wide">Specialisation</div>
              </div>
            </>
          )}
          {author.location && (
            <>
              <div class="w-px bg-slate-700 self-stretch"></div>
              <div class="text-center">
                <div class="text-sm font-bold text-white">{author.location}</div>
                <div class="text-xs text-slate-500 uppercase tracking-wide">Location</div>
              </div>
            </>
          )}
        </div>

        <!-- Meta row -->
        <div class="flex flex-wrap justify-center md:justify-start items-center gap-x-5 gap-y-2 text-sm text-slate-500">
          {author.degree && (
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-slate-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
              {author.degree}
            </span>
          )}

          <!-- Social links -->
          {author.linkedin && (
            <a href={author.linkedin} target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-1.5 hover:text-[#0077B5] transition-colors">
              <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
          )}
          {author.facebook && (
            <a href={author.facebook} target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-1.5 hover:text-[#1877F2] transition-colors">
              <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              Facebook
            </a>
          )}
          {author.instagram && (
            <a href={author.instagram} target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-1.5 hover:text-[#E1306C] transition-colors">
              <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              Instagram
            </a>
          )}
          {author.public_email && (
            <a href={`mailto:${author.public_email}`}
               class="flex items-center gap-1.5 hover:text-amber-400 transition-colors">
              <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              Email
            </a>
          )}
        </div>

        {isOwnProfile && (
          <div class="mt-6">
            <a href="/admin/profile"
               class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold text-sm px-5 py-2.5 rounded-xl transition-colors">
              <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              Edit Profile
            </a>
          </div>
        )}

      </div>
    </div>
  </div>
</section>

<!-- ═══ ARTICLES ═══ -->
<section class="max-w-5xl mx-auto px-5 py-12 sm:py-16">
  <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-900 mb-8">
    Articles by {author.display_name}
    <span class="text-lg font-normal text-stone-400 ml-2">({articles.length})</span>
  </h2>

  {articles.length === 0 ? (
    <div class="text-center py-16 px-6 bg-stone-50 rounded-2xl border border-stone-200">
      <p class="text-stone-500 font-medium">No published articles yet.</p>
    </div>
  ) : (
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {articles.map(article => {
        const cat = CATEGORIES[article.category as CategorySlug];
        return (
          <a href={`/articles/${article.slug}`}
             class="group bg-white rounded-2xl border border-stone-200 hover:border-stone-300 hover:shadow-md transition-all overflow-hidden flex flex-col">
            <div class={`h-1 w-full ${cat ? `bg-${cat.color}-500` : 'bg-amber-500'}`}></div>
            <div class="p-5 flex flex-col flex-1">
              <div class="mb-3">
                <span class={`inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full border ${getBadgeClass(cat?.color ?? 'stone')}`}>
                  {cat?.icon} {cat?.shortLabel ?? article.category}
                </span>
              </div>
              <h3 class="font-serif font-bold text-slate-800 text-base leading-snug mb-2 group-hover:text-amber-700 transition-colors line-clamp-3 flex-1">
                {article.title}
              </h3>
              <p class="text-stone-500 text-xs leading-relaxed line-clamp-2 mb-4">
                {article.excerpt}
              </p>
              <div class="flex items-center justify-between text-xs text-stone-400 pt-3 border-t border-stone-100">
                <time datetime={article.publishedAt}>{fmt(article.publishedAt)}</time>
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  {article.readTime} min
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  )}
</section>

</Base>
