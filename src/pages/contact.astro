---
import Base from '../layouts/Base.astro';
---
<Base title="Contact Lex Research — International Law Journal" description="Get in touch with Lex Research Journal — reach us by email or through social media for research inquiries, submissions, or collaborations.">

  <!-- Hero -->
  <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white py-16 sm:py-24">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
      <div class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-full mb-6">
        Get in Touch
      </div>
      <h1 class="serif text-4xl sm:text-5xl font-bold mb-5 leading-tight">Contact Us</h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-light">
        Whether you have a research enquiry, a submission question, or want to collaborate — we read every message.
      </p>
    </div>
  </div>

  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-12 sm:py-20 space-y-10">

    <!-- Email -->
    <section>
      <div class="text-xs font-bold uppercase tracking-widest text-amber-600 mb-3 text-center sm:text-left">Email</div>
      <div class="bg-stone-50 border border-stone-200 rounded-2xl p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5">
          <div class="w-14 h-14 rounded-2xl bg-slate-900 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div class="text-center sm:text-left">
            <div class="font-bold text-slate-900 text-base mb-1">Editorial Email</div>
            <p class="text-stone-500 text-sm mb-3 leading-relaxed">For research submissions, editorial enquiries, corrections, and collaboration proposals.</p>
            <a href="mailto:info@lexresearch.org" class="inline-flex items-center gap-2 bg-slate-900 hover:bg-slate-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              info@lexresearch.org
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Social Media -->
    <section>
      <div class="text-xs font-bold uppercase tracking-widest text-amber-600 mb-3 text-center sm:text-left">Social Media</div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

        <!-- Facebook -->
        <a href="https://www.facebook.com/lamia.a.sumaiya" target="_blank" rel="noopener noreferrer"
           class="group flex flex-col items-center gap-3 bg-[#1877F2]/5 border border-[#1877F2]/20 hover:bg-[#1877F2]/10 hover:border-[#1877F2]/40 rounded-2xl p-6 transition-all text-center">
          <div class="w-12 h-12 rounded-xl bg-[#1877F2] flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </div>
          <div>
            <div class="font-bold text-slate-900 text-sm">Facebook</div>
            <div class="text-xs text-stone-500 mt-0.5">@lamia.a.sumaiya</div>
          </div>
          <div class="text-[#1877F2] text-xs font-semibold group-hover:underline">Follow</div>
        </a>

        <!-- Instagram -->
        <a href="https://www.instagram.com/lamia.akhterr/" target="_blank" rel="noopener noreferrer"
           class="group flex flex-col items-center gap-3 bg-pink-50 border border-pink-200 hover:bg-pink-100 hover:border-pink-300 rounded-2xl p-6 transition-all text-center">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888)">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </div>
          <div>
            <div class="font-bold text-slate-900 text-sm">Instagram</div>
            <div class="text-xs text-stone-500 mt-0.5">@lamia.akhterr</div>
          </div>
          <div class="text-pink-600 text-xs font-semibold group-hover:underline">Follow</div>
        </a>

        <!-- LinkedIn -->
        <a href="https://www.linkedin.com/in/lamia-akhterr" target="_blank" rel="noopener noreferrer"
           class="group flex flex-col items-center gap-3 bg-[#0A66C2]/5 border border-[#0A66C2]/20 hover:bg-[#0A66C2]/10 hover:border-[#0A66C2]/40 rounded-2xl p-6 transition-all text-center">
          <div class="w-12 h-12 rounded-xl bg-[#0A66C2] flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>
          <div>
            <div class="font-bold text-slate-900 text-sm">LinkedIn</div>
            <div class="text-xs text-stone-500 mt-0.5">lamia-akhterr</div>
          </div>
          <div class="text-[#0A66C2] text-xs font-semibold group-hover:underline">Connect</div>
        </a>

      </div>
    </section>

    <!-- What to write about -->
    <section>
      <div class="text-xs font-bold uppercase tracking-widest text-amber-600 mb-3 text-center sm:text-left">What to Include</div>
      <div class="border border-stone-200 rounded-2xl divide-y divide-stone-100">
        {[
          { icon: '📝', title: 'Submissions', body: 'Include a working title, your research area, and a 100-word abstract. We cover international law, human rights law, comparative law, and all fifteen categories listed on our About page.' },
          { icon: '🔍', title: 'Corrections', body: 'If you have identified a factual error, an incorrect citation, or a legal misstatement in a published article, include the article title, the specific paragraph, and the correct information with a source.' },
          { icon: '🤝', title: 'Collaboration', body: 'Academic institutions, legal NGOs, and practitioner organisations are welcome to propose partnerships. Include a brief description of your organisation and the nature of the proposed collaboration.' },
          { icon: '💬', title: 'General Enquiries', body: 'For all other questions including republication requests, media enquiries, and reader feedback, email us directly. We aim to respond within 3 to 5 business days.' },
        ].map(item => (
          <div class="flex items-start gap-4 p-5">
            <div class="text-xl flex-shrink-0 mt-0.5">{item.icon}</div>
            <div>
              <div class="font-semibold text-slate-900 text-sm mb-1">{item.title}</div>
              <p class="text-xs text-stone-500 leading-relaxed">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom CTA -->
    <div class="bg-slate-900 rounded-2xl p-7 sm:p-9 text-center">
      <div class="text-3xl mb-3">✉️</div>
      <h3 class="serif text-xl sm:text-2xl font-bold text-white mb-2">Ready to reach out?</h3>
      <p class="text-slate-400 text-sm mb-6">Send us an email or connect on social media. We look forward to hearing from you.</p>
      <a href="mailto:info@lexresearch.org" class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold px-6 py-3 rounded-xl text-sm transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        info@lexresearch.org
      </a>
    </div>

  </div>

</Base>
