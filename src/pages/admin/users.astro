---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSession, isAdmin, getAllUsers, updateUserStatus, sendApprovalEmail } from '../../lib/auth';

// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';
const kv = (cfEnv as any).SESSION;

const session = await getSession(Astro.request, kv);
if (!session) return Astro.redirect('/admin/login');
if (!isAdmin(session.role)) return Astro.redirect('/admin');

let successMsg = '';
let errorMsg = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action') as string;
  const userId = form.get('user_id') as string;
  const userEmail = form.get('user_email') as string;
  const userName = form.get('user_name') as string;

  if (action === 'approve' && userId) {
    await updateUserStatus(userId, 'approved');
    try {
      await sendApprovalEmail(userEmail, userName);
    } catch (_) { /* Email failure shouldn't break the action */ }
    successMsg = `${userName} has been approved and notified by email.`;
  } else if (action === 'reject' && userId) {
    await updateUserStatus(userId, 'rejected');
    successMsg = `${userName}'s registration has been rejected.`;
  } else if (action === 'reactivate' && userId) {
    await updateUserStatus(userId, 'approved');
    successMsg = `${userName}'s account has been reactivated.`;
  }
}

const users = await getAllUsers();
const pending  = users.filter(u => u.status === 'pending');
const approved = users.filter(u => u.status === 'approved');
const rejected = users.filter(u => u.status === 'rejected');

function fmt(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---
<AdminLayout title="User Management" session={session}>

  {successMsg && (
    <div class="mb-6 bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm px-4 py-3 rounded-xl flex items-center gap-2.5">
      <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      {successMsg}
    </div>
  )}

  {errorMsg && (
    <div class="mb-6 bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-xl flex items-center gap-2.5">
      <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      {errorMsg}
    </div>
  )}

  <!-- Stats -->
  <div class="grid grid-cols-3 gap-4 mb-8">
    <div class="bg-white rounded-2xl border border-stone-200 p-5">
      <div class="text-xs font-bold text-stone-400 uppercase tracking-wider mb-1">Pending</div>
      <div class="text-3xl font-bold text-amber-500">{pending.length}</div>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-5">
      <div class="text-xs font-bold text-stone-400 uppercase tracking-wider mb-1">Approved</div>
      <div class="text-3xl font-bold text-emerald-600">{approved.length}</div>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-5">
      <div class="text-xs font-bold text-stone-400 uppercase tracking-wider mb-1">Rejected</div>
      <div class="text-3xl font-bold text-red-500">{rejected.length}</div>
    </div>
  </div>

  <!-- Pending Approvals -->
  {pending.length > 0 && (
    <div class="bg-white rounded-2xl border border-amber-200 overflow-hidden mb-6">
      <div class="flex items-center gap-3 px-5 sm:px-6 py-4 border-b border-amber-100 bg-amber-50">
        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        <h2 class="font-semibold text-amber-800">Pending Approval ({pending.length})</h2>
      </div>
      <div class="divide-y divide-stone-100">
        {pending.map(u => (
          <div class="flex flex-col sm:flex-row sm:items-center gap-4 px-5 sm:px-6 py-4">
            <div class="flex items-center gap-3 flex-1 min-w-0">
              <div class="w-9 h-9 rounded-full bg-amber-100 flex items-center justify-center text-amber-700 font-black text-sm flex-shrink-0">
                {u.display_name.charAt(0).toUpperCase()}
              </div>
              <div class="min-w-0">
                <div class="font-semibold text-slate-800 truncate">{u.display_name}</div>
                <div class="text-xs text-stone-400 truncate">{u.email}</div>
                <div class="text-xs text-stone-400 mt-0.5">Registered {fmt(u.created_at)}</div>
              </div>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <form method="POST">
                <input type="hidden" name="action" value="approve" />
                <input type="hidden" name="user_id" value={u.id} />
                <input type="hidden" name="user_email" value={u.email} />
                <input type="hidden" name="user_name" value={u.display_name} />
                <button type="submit"
                  class="inline-flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-3 py-2 rounded-lg transition-colors">
                  <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                  Approve
                </button>
              </form>
              <form method="POST" onsubmit="return confirm('Reject this registration?')">
                <input type="hidden" name="action" value="reject" />
                <input type="hidden" name="user_id" value={u.id} />
                <input type="hidden" name="user_email" value={u.email} />
                <input type="hidden" name="user_name" value={u.display_name} />
                <button type="submit"
                  class="inline-flex items-center gap-1.5 border border-red-200 text-red-600 hover:bg-red-50 text-xs font-semibold px-3 py-2 rounded-lg transition-colors">
                  <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                  Reject
                </button>
              </form>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  {pending.length === 0 && (
    <div class="bg-emerald-50 border border-emerald-200 rounded-2xl px-6 py-5 mb-6 flex items-center gap-3 text-emerald-700 text-sm font-medium">
      <svg class="w-5 h-5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      No pending registrations — all caught up!
    </div>
  )}

  <!-- All Authors -->
  {users.length > 0 && (
    <div class="bg-white rounded-2xl border border-stone-200 overflow-hidden">
      <div class="px-5 sm:px-6 py-4 border-b border-stone-100">
        <h2 class="font-semibold text-slate-800">All Authors ({users.length})</h2>
      </div>
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-stone-50 border-b border-stone-100">
              <th class="text-left px-6 py-3 text-xs font-bold text-stone-400 uppercase tracking-wider">Name</th>
              <th class="text-left px-4 py-3 text-xs font-bold text-stone-400 uppercase tracking-wider">Email</th>
              <th class="text-left px-4 py-3 text-xs font-bold text-stone-400 uppercase tracking-wider">Registered</th>
              <th class="text-left px-4 py-3 text-xs font-bold text-stone-400 uppercase tracking-wider">Status</th>
              <th class="text-right px-6 py-3 text-xs font-bold text-stone-400 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            {users.map(u => (
              <tr class="hover:bg-stone-50 transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-bold text-xs flex-shrink-0">
                      {u.display_name.charAt(0).toUpperCase()}
                    </div>
                    <span class="font-medium text-slate-800">{u.display_name}</span>
                  </div>
                </td>
                <td class="px-4 py-4 text-stone-500 text-xs">{u.email}</td>
                <td class="px-4 py-4 text-stone-500 text-xs whitespace-nowrap">{fmt(u.created_at)}</td>
                <td class="px-4 py-4">
                  {u.status === 'approved' && (
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-full">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Approved
                    </span>
                  )}
                  {u.status === 'pending' && (
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-full">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>Pending
                    </span>
                  )}
                  {u.status === 'rejected' && (
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-red-700 bg-red-50 border border-red-200 px-2.5 py-1 rounded-full">
                      <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>Rejected
                    </span>
                  )}
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center justify-end gap-2">
                    {u.status === 'pending' && (
                      <form method="POST">
                        <input type="hidden" name="action" value="approve" />
                        <input type="hidden" name="user_id" value={u.id} />
                        <input type="hidden" name="user_email" value={u.email} />
                        <input type="hidden" name="user_name" value={u.display_name} />
                        <button type="submit" class="text-xs font-semibold text-emerald-700 hover:text-emerald-900 transition-colors">Approve</button>
                      </form>
                    )}
                    {u.status === 'pending' && (
                      <form method="POST" onsubmit="return confirm('Reject this user?')">
                        <input type="hidden" name="action" value="reject" />
                        <input type="hidden" name="user_id" value={u.id} />
                        <input type="hidden" name="user_email" value={u.email} />
                        <input type="hidden" name="user_name" value={u.display_name} />
                        <button type="submit" class="text-xs font-semibold text-red-600 hover:text-red-800 transition-colors">Reject</button>
                      </form>
                    )}
                    {u.status === 'rejected' && (
                      <form method="POST">
                        <input type="hidden" name="action" value="reactivate" />
                        <input type="hidden" name="user_id" value={u.id} />
                        <input type="hidden" name="user_email" value={u.email} />
                        <input type="hidden" name="user_name" value={u.display_name} />
                        <button type="submit" class="text-xs font-semibold text-blue-600 hover:text-blue-800 transition-colors">Reactivate</button>
                      </form>
                    )}
                    {u.status === 'approved' && (
                      <form method="POST" onsubmit="return confirm('Reject this user? They will lose access.')">
                        <input type="hidden" name="action" value="reject" />
                        <input type="hidden" name="user_id" value={u.id} />
                        <input type="hidden" name="user_email" value={u.email} />
                        <input type="hidden" name="user_name" value={u.display_name} />
                        <button type="submit" class="text-xs font-semibold text-stone-400 hover:text-red-600 transition-colors">Revoke</button>
                      </form>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mobile list -->
      <div class="md:hidden divide-y divide-stone-100">
        {users.map(u => (
          <div class="px-5 py-4">
            <div class="flex items-center justify-between gap-3 mb-2">
              <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-bold text-xs flex-shrink-0">
                  {u.display_name.charAt(0).toUpperCase()}
                </div>
                <div class="min-w-0">
                  <div class="font-semibold text-slate-800 text-sm truncate">{u.display_name}</div>
                  <div class="text-xs text-stone-400 truncate">{u.email}</div>
                </div>
              </div>
              {u.status === 'approved' && <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full flex-shrink-0">Active</span>}
              {u.status === 'pending'  && <span class="text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full flex-shrink-0">Pending</span>}
              {u.status === 'rejected' && <span class="text-xs font-semibold text-red-700 bg-red-50 border border-red-200 px-2 py-0.5 rounded-full flex-shrink-0">Rejected</span>}
            </div>
            <div class="flex gap-2 mt-2">
              {u.status === 'pending' && (
                <>
                  <form method="POST" class="flex-1">
                    <input type="hidden" name="action" value="approve" />
                    <input type="hidden" name="user_id" value={u.id} />
                    <input type="hidden" name="user_email" value={u.email} />
                    <input type="hidden" name="user_name" value={u.display_name} />
                    <button type="submit" class="w-full text-center text-xs font-semibold bg-emerald-600 text-white px-3 py-2 rounded-lg transition-colors">Approve</button>
                  </form>
                  <form method="POST" class="flex-1" onsubmit="return confirm('Reject?')">
                    <input type="hidden" name="action" value="reject" />
                    <input type="hidden" name="user_id" value={u.id} />
                    <input type="hidden" name="user_email" value={u.email} />
                    <input type="hidden" name="user_name" value={u.display_name} />
                    <button type="submit" class="w-full text-center text-xs font-semibold border border-red-200 text-red-600 px-3 py-2 rounded-lg transition-colors">Reject</button>
                  </form>
                </>
              )}
              {u.status === 'rejected' && (
                <form method="POST" class="flex-1">
                  <input type="hidden" name="action" value="reactivate" />
                  <input type="hidden" name="user_id" value={u.id} />
                  <input type="hidden" name="user_email" value={u.email} />
                  <input type="hidden" name="user_name" value={u.display_name} />
                  <button type="submit" class="w-full text-center text-xs font-semibold bg-blue-600 text-white px-3 py-2 rounded-lg transition-colors">Reactivate</button>
                </form>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

</AdminLayout>
