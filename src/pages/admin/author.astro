---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAuthenticated } from '../../lib/auth';
import { getSettings, saveSetting } from '../../lib/articles';

if (!isAuthenticated(Astro.request)) {
  return Astro.redirect('/admin/login');
}

let success = false;
let error = '';

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const fields = [
      'author_name','author_title','author_bio','author_location',
      'author_degree','author_specialisation',
      'author_facebook','author_instagram','author_linkedin','author_email',
    ];
    for (const key of fields) {
      const val = (form.get(key) as string || '').trim();
      await saveSetting(Astro.locals, key, val);
    }
    success = true;
  } catch (e: any) {
    error = e?.message ?? 'Failed to save. Please try again.';
  }
}

const s = await getSettings(Astro.locals);
---
<AdminLayout title="Edit Author Profile">

  <div class="max-w-2xl">

    <div class="flex items-center gap-2 text-xs text-stone-400 mb-5">
      <a href="/admin" class="hover:text-slate-700 transition-colors">Dashboard</a>
      <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-stone-500">Author Profile</span>
    </div>

    {success && (
      <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm px-4 py-3 rounded-xl mb-6 flex items-center gap-2.5">
        <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        Profile saved successfully.
      </div>
    )}
    {error && (
      <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-xl mb-6 flex items-center gap-2.5">
        <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {error}
      </div>
    )}

    <form method="POST" class="space-y-5">

      <!-- Basic Info -->
      <div class="bg-white rounded-2xl border border-stone-200 p-6 space-y-5">
        <h2 class="text-xs font-bold text-stone-400 uppercase tracking-widest">Basic Information</h2>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Full Name</label>
          <input type="text" name="author_name" required value={s.author_name ?? ''}
            class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Title / Role</label>
          <input type="text" name="author_title" value={s.author_title ?? ''}
            placeholder="e.g. LLB Student & Legal Researcher"
            class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Bio</label>
          <textarea name="author_bio" rows="4"
            class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition resize-none">{s.author_bio ?? ''}</textarea>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Location</label>
            <input type="text" name="author_location" value={s.author_location ?? ''}
              placeholder="e.g. Dhaka, Bangladesh"
              class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Degree</label>
            <input type="text" name="author_degree" value={s.author_degree ?? ''}
              placeholder="e.g. LLB (Ongoing)"
              class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Specialisation</label>
          <input type="text" name="author_specialisation" value={s.author_specialisation ?? ''}
            placeholder="e.g. International Law"
            class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition" />
        </div>
      </div>

      <!-- Social Links -->
      <div class="bg-white rounded-2xl border border-stone-200 p-6 space-y-5">
        <h2 class="text-xs font-bold text-stone-400 uppercase tracking-widest">Social & Contact</h2>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">
            <span class="inline-flex items-center gap-2">
              <svg class="w-4 h-4 text-[#1877F2]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              Facebook URL
            </span>
          </label>
          <input type="url" name="author_facebook" value={s.author_facebook ?? ''}
            placeholder="https://facebook.com/yourpage"
            class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition font-mono" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">
            <span class="inline-flex items-center gap-2">
              <svg class="w-4 h-4 text-[#E1306C]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              Instagram URL
            </span>
          </label>
          <input type="url" name="author_instagram" value={s.author_instagram ?? ''}
            placeholder="https://instagram.com/yourhandle"
            class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition font-mono" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">
            <span class="inline-flex items-center gap-2">
              <svg class="w-4 h-4 text-[#0077B5]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn URL
            </span>
          </label>
          <input type="url" name="author_linkedin" value={s.author_linkedin ?? ''}
            placeholder="https://linkedin.com/in/yourprofile"
            class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition font-mono" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Email Address</label>
          <input type="email" name="author_email" value={s.author_email ?? ''}
            placeholder="your@email.com"
            class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition font-mono" />
        </div>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <button type="submit"
          class="bg-slate-900 hover:bg-slate-800 text-white font-semibold px-7 py-3 rounded-xl text-sm transition-colors flex items-center gap-2">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Save Profile
        </button>
        <a href="/lamia-akhter" target="_blank"
           class="text-sm text-stone-500 hover:text-slate-800 px-5 py-3 rounded-xl border border-stone-200 hover:border-stone-400 transition-all flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          View Live Profile
        </a>
      </div>

    </form>
  </div>

</AdminLayout>
