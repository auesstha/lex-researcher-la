---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import CategorySelect from '../../../components/CategorySelect.astro';
import { isAuthenticated } from '../../../lib/auth';
import { saveArticle } from '../../../lib/articles';
import type { Article } from '../../../lib/articles';

if (!isAuthenticated(Astro.request)) {
  return Astro.redirect('/admin/login');
}

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const title       = (form.get('title')       as string || '').trim();
  const slug        = (form.get('slug')        as string || '').trim();
  const category    =  form.get('category')    as string;
  const excerpt     = (form.get('excerpt')     as string || '').trim();
  const content     = (form.get('content')     as string || '').trim();
  const author      = (form.get('author')      as string || '').trim();
  const authorTitle = (form.get('authorTitle') as string || '').trim();
  const tags        = (form.get('tags')        as string || '').split(',').map(t => t.trim()).filter(Boolean);
  const readTime    = parseInt(form.get('readTime') as string) || 5;
  const published   = form.get('published') === '1';

  if (!title || !slug || !category || !content || !author) {
    error = 'Please fill in all required fields (Title, Slug, Category, Author, Content).';
  } else {
    const now = new Date().toISOString();
    await saveArticle(Astro.locals, { id: Date.now().toString(), title, slug, category: category as Article['category'], excerpt, content, author, authorTitle, tags, readTime, published, publishedAt: now, updatedAt: now });
    return Astro.redirect('/admin');
  }
}
---
<AdminLayout title="New Article">

  <div class="max-w-4xl">

    {error && (
      <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-xl mb-6 flex items-center gap-2.5">
        <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {error}
      </div>
    )}

    <form method="POST" class="space-y-5">

      <!-- Basics -->
      <div class="bg-white rounded-2xl border border-stone-200 p-6 space-y-5">
        <h2 class="text-xs font-bold text-stone-400 uppercase tracking-widest">Article Details</h2>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">
            Title <span class="text-red-500">*</span>
          </label>
          <input type="text" name="title" required placeholder="e.g. The Doctrine of Sovereignty in Modern International Law"
            class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition"
            oninput="autoSlug(this.value)" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">
            URL Slug <span class="text-red-500">*</span>
          </label>
          <div class="flex items-stretch border border-stone-300 rounded-xl overflow-hidden focus-within:ring-2 focus-within:ring-slate-900 focus-within:border-transparent transition">
            <span class="bg-stone-50 border-r border-stone-300 px-3 py-2.5 text-xs text-stone-400 font-mono flex items-center">/articles/</span>
            <input type="text" name="slug" id="slug" required placeholder="doctrine-of-sovereignty"
              class="flex-1 px-3 py-2.5 text-sm font-mono focus:outline-none bg-white" />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">
              Category <span class="text-red-500">*</span>
            </label>
            <CategorySelect />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Read Time (minutes)</label>
            <input type="number" name="readTime" min="1" max="60" value="5"
              class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Abstract / Excerpt</label>
          <textarea name="excerpt" rows="3"
            placeholder="A concise summary of the article's argument, scope, and significance (shown in listings and previews)…"
            class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition resize-none"></textarea>
        </div>
      </div>

      <!-- Body -->
      <div class="bg-white rounded-2xl border border-stone-200 overflow-hidden">

        <!-- Toolbar -->
        <div class="border-b border-stone-200 bg-stone-50 px-3 py-2 flex flex-wrap items-center gap-0.5" id="md-toolbar">
          <span class="text-[10px] text-stone-400 font-bold uppercase tracking-wider mr-0.5">H</span>
          <button type="button" data-action="h1" title="Heading 1 (Ctrl+1)" class="toolbar-btn font-bold text-xs px-2 py-1.5">H1</button>
          <button type="button" data-action="h2" title="Heading 2 (Ctrl+2)" class="toolbar-btn font-bold text-xs px-2 py-1.5">H2</button>
          <button type="button" data-action="h3" title="Heading 3 (Ctrl+3)" class="toolbar-btn font-bold text-xs px-2 py-1.5">H3</button>
          <div class="w-px h-5 bg-stone-300 mx-1.5"></div>
          <button type="button" data-action="bold"          title="Bold (Ctrl+B)"      class="toolbar-btn font-bold text-sm px-2 py-1.5">B</button>
          <button type="button" data-action="italic"        title="Italic (Ctrl+I)"    class="toolbar-btn italic text-sm px-2 py-1.5">I</button>
          <button type="button" data-action="underline"     title="Underline (Ctrl+U)" class="toolbar-btn underline text-sm px-2 py-1.5">U</button>
          <button type="button" data-action="strikethrough" title="Strikethrough"      class="toolbar-btn line-through text-xs px-2 py-1.5">S</button>
          <div class="w-px h-5 bg-stone-300 mx-1.5"></div>
          <button type="button" data-action="blockquote" title="Blockquote"      class="toolbar-btn text-xs px-2 py-1.5">&ldquo; Quote</button>
          <button type="button" data-action="code-block" title="Code block"      class="toolbar-btn text-xs font-mono px-2 py-1.5">&lt;/&gt;</button>
          <button type="button" data-action="ul"         title="Bullet list"     class="toolbar-btn text-xs px-2 py-1.5">• List</button>
          <button type="button" data-action="ol"         title="Numbered list"   class="toolbar-btn text-xs px-2 py-1.5">1. List</button>
          <button type="button" data-action="hr"         title="Divider line"    class="toolbar-btn text-xs px-2 py-1.5">— HR</button>
          <div class="w-px h-5 bg-stone-300 mx-1.5"></div>
          <button type="button" data-action="link"        title="Insert link"       class="toolbar-btn text-xs px-2 py-1.5">🔗</button>
          <button type="button" data-action="image"       title="Insert image"      class="toolbar-btn text-xs px-2 py-1.5">🖼</button>
          <button type="button" data-action="paragraph"   title="Reset to paragraph" class="toolbar-btn text-xs px-2 py-1.5">¶</button>
          <button type="button" data-action="faq-heading" title="Insert FAQ heading" class="toolbar-btn text-xs px-2 py-1.5">❓</button>
          <button type="button" id="preview-toggle" class="toolbar-btn text-xs px-2.5 py-1.5 ml-auto">👁 Preview</button>
        </div>

        <div class="bg-amber-50 border-b border-amber-100 px-4 py-1.5 flex flex-wrap gap-x-4 gap-y-0.5 text-[11px] text-amber-700">
          <span><strong>H1/H2/H3</strong> = Ctrl+1/2/3 · converts current line</span>
          <span>Select text → <strong>B</strong> / <em>I</em> / <u>U</u> to format</span>
          <span><strong>¶</strong> resets to body text</span>
          <span>Ctrl+B / Ctrl+I / Ctrl+U</span>
        </div>

        <div class="relative">
          <div id="md-editor" contenteditable="true" spellcheck="true"
            class="wysiwyg-editor w-full px-5 py-4 focus:outline-none leading-8 min-h-[420px] overflow-auto"></div>
          <input type="hidden" name="content" id="md-content-hidden">
          <div id="md-preview" class="hidden w-full min-h-[400px] px-5 py-4 text-sm leading-8 text-slate-800 overflow-auto border-t border-stone-100"></div>
        </div>

        <div class="border-t border-stone-100 px-5 py-2 flex items-center justify-between bg-stone-50">
          <span class="text-xs text-stone-400"><span id="word-count">0</span> words · <span id="char-count">0</span> characters</span>
          <span class="text-xs text-stone-400">Blank line = new paragraph</span>
        </div>
      </div>

      <style>{`
        /* ── Toolbar ─────────────────────────────────────────────── */
        .toolbar-btn { border-radius:6px; border:1px solid transparent; color:#44403c; background:transparent; cursor:pointer; transition:all 0.1s; line-height:1; }
        .toolbar-btn:hover { background:#e7e5e4; border-color:#d6d3d1; }
        .toolbar-btn:active { background:#d6d3d1; }
        .toolbar-btn--active { background:#1e293b !important; color:#fff !important; border-color:#1e293b !important; }

        /* ── Editor — ID selector beats Tailwind preflight ───────── */
        #md-editor { outline:none !important; font-family:'Georgia',serif !important; font-size:1rem !important; color:#1e293b !important; line-height:1.85 !important; border:none; background:#fff; }
        #md-editor:empty::before { content:'Start writing your article here\2026'; color:#d6d3d1; pointer-events:none; display:block; }
        #md-editor ::selection { background:#fef3c7; color:#0f172a; }

        #md-editor h1 { font-family:'Playfair Display',Georgia,serif !important; font-size:1.8rem !important; font-weight:700 !important; color:#0f172a !important; margin:1.5rem 0 0.5rem !important; line-height:1.2 !important; border-bottom:2px solid #e7e5e4 !important; padding-bottom:0.35rem !important; display:block !important; }
        #md-editor h2 { font-family:'Playfair Display',Georgia,serif !important; font-size:1.35rem !important; font-weight:700 !important; color:#0f172a !important; margin:1.5rem 0 0.4rem !important; line-height:1.3 !important; border-left:3px solid #f59e0b !important; padding-left:0.75rem !important; display:block !important; }
        #md-editor h3 { font-family:'Playfair Display',Georgia,serif !important; font-size:1.1rem !important; font-weight:700 !important; color:#1e293b !important; margin:1.2rem 0 0.3rem !important; display:block !important; }
        #md-editor p  { margin:0.6rem 0 !important; color:#374151 !important; line-height:1.9 !important; display:block !important; }
        #md-editor div { margin:0.4rem 0 !important; color:#374151 !important; line-height:1.9 !important; display:block !important; }
        #md-editor blockquote { border-left:3px solid #f59e0b !important; margin:1rem 0 !important; padding:0.5rem 0 0.5rem 1rem !important; color:#57534e !important; font-style:italic !important; background:#fffbeb !important; border-radius:0 8px 8px 0 !important; display:block !important; }
        #md-editor pre { background:#f1f5f9 !important; border:1px solid #e2e8f0 !important; border-radius:8px !important; padding:0.75rem 1rem !important; font-family:monospace !important; font-size:0.85rem !important; margin:0.8rem 0 !important; overflow-x:auto !important; white-space:pre-wrap !important; display:block !important; }
        #md-editor code { background:#f1f5f9 !important; border-radius:4px !important; padding:0.1em 0.35em !important; font-family:monospace !important; font-size:0.85em !important; color:#be185d !important; }
        #md-editor ul { list-style:disc !important; margin:0.5rem 0 0.5rem 1.75rem !important; display:block !important; }
        #md-editor ol { list-style:decimal !important; margin:0.5rem 0 0.5rem 1.75rem !important; display:block !important; }
        #md-editor li { margin:0.25rem 0 !important; line-height:1.7 !important; color:#374151 !important; }
        #md-editor hr { border:none !important; border-top:2px solid #e7e5e4 !important; margin:1.5rem 0 !important; display:block !important; }
        #md-editor strong, #md-editor b { font-weight:700 !important; color:#0f172a !important; }
        #md-editor em, #md-editor i { font-style:italic !important; }
        #md-editor u { text-decoration:underline !important; text-decoration-color:#f59e0b !important; }
        #md-editor del, #md-editor s { text-decoration:line-through !important; color:#78716c !important; }
        #md-editor a { color:#92400e !important; text-decoration:underline !important; }
        #md-editor img { max-width:100% !important; border-radius:10px !important; margin:0.75rem 0 !important; display:block !important; border:1px solid #e7e5e4 !important; }

        /* ── Preview pane — article typography ───────────────────── */
        #md-preview { font-family:'Georgia',serif; font-size:1rem; color:#374151; line-height:1.85; background:#fff; }
        #md-preview h1 { font-family:'Playfair Display',Georgia,serif; font-size:1.9rem; font-weight:700; color:#0f172a; margin:0 0 1rem; line-height:1.2; border-bottom:2px solid #e7e5e4; padding-bottom:0.5rem; }
        #md-preview h2 { font-family:'Playfair Display',Georgia,serif; font-size:1.4rem; font-weight:700; color:#0f172a; margin:2.2rem 0 0.6rem; border-left:3px solid #f59e0b; padding-left:0.75rem; line-height:1.3; }
        #md-preview h3 { font-family:'Playfair Display',Georgia,serif; font-size:1.1rem; font-weight:700; color:#1e293b; margin:1.6rem 0 0.4rem; }
        #md-preview p  { margin:0.9rem 0; color:#374151; line-height:1.9; }
        #md-preview blockquote { border-left:3px solid #f59e0b; margin:1.2rem 0; padding:0.6rem 1rem; color:#57534e; font-style:italic; background:#fffbeb; border-radius:0 8px 8px 0; }
        #md-preview pre { background:#f1f5f9; border:1px solid #e2e8f0; border-radius:8px; padding:0.75rem 1rem; font-family:monospace; font-size:0.85rem; margin:1rem 0; overflow-x:auto; }
        #md-preview code { background:#f1f5f9; border-radius:4px; padding:0.1em 0.35em; font-family:monospace; font-size:0.85em; color:#be185d; }
        #md-preview ul { list-style:disc; margin:0.6rem 0 0.6rem 1.75rem; }
        #md-preview ol { list-style:decimal; margin:0.6rem 0 0.6rem 1.75rem; }
        #md-preview li { margin:0.3rem 0; color:#374151; line-height:1.75; }
        #md-preview hr { border:none; border-top:2px solid #e7e5e4; margin:2rem 0; }
        #md-preview strong, #md-preview b { font-weight:700; color:#0f172a; }
        #md-preview em, #md-preview i { font-style:italic; }
        #md-preview u { text-decoration:underline; text-decoration-color:#f59e0b; }
        #md-preview del { text-decoration:line-through; color:#78716c; }
        #md-preview a { color:#92400e; text-decoration:underline; }
        #md-preview img { max-width:100%; border-radius:12px; margin:1.2rem 0; border:1px solid #e7e5e4; display:block; }
      `}</style>

      <script is:inline>
        (function () {
          var editor      = document.getElementById('md-editor');
          var hiddenInput = document.getElementById('md-content-hidden');
          var preview     = document.getElementById('md-preview');
          var toggle      = document.getElementById('preview-toggle');
          var wordEl      = document.getElementById('word-count');
          var charEl      = document.getElementById('char-count');
          if (!editor || !hiddenInput) return;

          // Use <p> as the default block so Chrome doesn't insert bare <div>s
          try { document.execCommand('defaultParagraphSeparator', false, 'p'); } catch(e){}

          // ── Saved selection (restored before execCommand calls) ───────────────
          var savedRange = null;
          editor.addEventListener('blur', function() {
            var sel = window.getSelection();
            if (sel && sel.rangeCount > 0 && editor.contains(sel.anchorNode)) {
              savedRange = sel.getRangeAt(0).cloneRange();
            }
          });
          function restoreSel() {
            if (!savedRange) return;
            var sel = window.getSelection();
            if (sel) { sel.removeAllRanges(); sel.addRange(savedRange); }
          }

          // ── Inline → HTML ─────────────────────────────────────────────────────
          function inlineToHtml(t) {
            return t
              .replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1">')
              .replace(/\[([^\]]+)\]\(([^)]+)\)/g,  '<a href="$2">$1</a>')
              .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
              .replace(/\*(.+?)\*/g,     '<em>$1</em>')
              .replace(/~~(.+?)~~/g,     '<del>$1</del>')
              .replace(/`([^`]+)`/g,     '<code>$1</code>');
          }

          // ── Markdown → HTML ───────────────────────────────────────────────────
          function mdToHtml(md) {
            var lines = md.split('\n'), html = '', i = 0;
            while (i < lines.length) {
              var line = lines[i];
              if (line.trim() === '```') {
                var code = ''; i++;
                while (i < lines.length && lines[i].trim() !== '```') { code += lines[i] + '\n'; i++; }
                html += '<pre><code>' + code.trim().replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</code></pre>';
                i++; continue;
              }
              if (/^---+$/.test(line.trim())) { html += '<hr>'; i++; continue; }
              if (line.startsWith('### ')) { html += '<h3>' + inlineToHtml(line.slice(4).trim()) + '</h3>'; i++; continue; }
              if (line.startsWith('## '))  { html += '<h2>' + inlineToHtml(line.slice(3).trim()) + '</h2>'; i++; continue; }
              if (line.startsWith('# '))   { html += '<h1>' + inlineToHtml(line.slice(2).trim()) + '</h1>'; i++; continue; }
              if (line.startsWith('> ')) {
                var bq = '';
                while (i < lines.length && lines[i].startsWith('> ')) { bq += lines[i].slice(2) + '\n'; i++; }
                html += '<blockquote>' + inlineToHtml(bq.trim()) + '</blockquote>'; continue;
              }
              if (/^[-*] /.test(line)) {
                html += '<ul>';
                while (i < lines.length && /^[-*] /.test(lines[i])) { html += '<li>' + inlineToHtml(lines[i].slice(2).trim()) + '</li>'; i++; }
                html += '</ul>'; continue;
              }
              if (/^\d+\. /.test(line)) {
                html += '<ol>';
                while (i < lines.length && /^\d+\. /.test(lines[i])) { html += '<li>' + inlineToHtml(lines[i].replace(/^\d+\. /,'').trim()) + '</li>'; i++; }
                html += '</ol>'; continue;
              }
              if (line.trim() === '') { i++; continue; }
              var para = '';
              while (i < lines.length && lines[i].trim() !== '' && !/^[#>]/.test(lines[i]) && !/^[-*] /.test(lines[i]) && !/^\d+\. /.test(lines[i]) && !/^---+$/.test(lines[i].trim()) && lines[i].trim() !== '```') {
                para += (para ? '<br>' : '') + inlineToHtml(lines[i]); i++;
              }
              if (para) html += '<p>' + para + '</p>';
            }
            return html;
          }

          // ── HTML → Markdown ───────────────────────────────────────────────────
          function nodeToMd(node) {
            if (node.nodeType === 3) return node.textContent;
            if (node.nodeType !== 1) return '';
            var tag = node.tagName.toLowerCase();
            var inner = Array.from(node.childNodes).map(nodeToMd).join('');
            switch (tag) {
              case 'br':         return '\n';
              case 'p':          return inner.trim() ? inner.trim() + '\n\n' : '';
              case 'div':        return inner.trim() ? inner.trim() + '\n\n' : '';
              case 'h1':         return '# '   + inner.trim() + '\n\n';
              case 'h2':         return '## '  + inner.trim() + '\n\n';
              case 'h3':         return '### ' + inner.trim() + '\n\n';
              case 'blockquote': return '> ' + inner.trim().replace(/\n/g, '\n> ') + '\n\n';
              case 'pre':        return '```\n' + (node.innerText || inner).trim() + '\n```\n\n';
              case 'ul':         return inner + '\n';
              case 'ol':         return inner + '\n';
              case 'li':         return '- ' + inner.trim() + '\n';
              case 'hr':         return '---\n\n';
              case 'strong': case 'b':   return '**' + inner + '**';
              case 'em':     case 'i':   return '*' + inner + '*';
              case 'u':          return '__' + inner + '__';
              case 'del':    case 's':   return '~~' + inner + '~~';
              case 'code':       return '`' + inner + '`';
              case 'a':          return '[' + inner + '](' + (node.getAttribute('href') || '') + ')';
              case 'img':        return '![' + (node.getAttribute('alt') || 'image') + '](' + (node.getAttribute('src') || '') + ')';
              case 'span': {
                // Chrome execCommand creates <span style="..."> instead of semantic tags
                var st = node.getAttribute('style') || '';
                var r = inner;
                if (/font-weight\s*:\s*(bold|700)/i.test(st))          r = '**' + r + '**';
                if (/font-style\s*:\s*italic/i.test(st))               r = '*' + r + '*';
                if (/text-decoration[^;]*underline/i.test(st))         r = '__' + r + '__';
                if (/text-decoration[^;]*line-through/i.test(st))      r = '~~' + r + '~~';
                return r;
              }
              default:           return inner;
            }
          }

          function htmlToMd() {
            var tmp = document.createElement('div');
            tmp.innerHTML = editor.innerHTML;
            return Array.from(tmp.childNodes).map(nodeToMd).join('').replace(/\n{3,}/g, '\n\n').trim();
          }

          // ── Apply block format (reliable) ─────────────────────────────────────
          function applyBlock(tag) {
            editor.focus();
            var sel = window.getSelection();
            if (!sel || !sel.rangeCount || !editor.contains(sel.anchorNode)) {
              var el = document.createElement(tag);
              el.innerHTML = '<br>';
              editor.appendChild(el);
              var r = document.createRange();
              r.selectNodeContents(el); r.collapse(false);
              sel.removeAllRanges(); sel.addRange(r);
              updateCount(); updateActiveStates(); return;
            }
            var node = sel.getRangeAt(0).startContainer;
            while (node && node !== editor) {
              if (node.nodeType === 1 && /^(P|H[1-6]|DIV|BLOCKQUOTE|PRE|LI)$/i.test(node.tagName)) break;
              node = node.parentNode;
            }
            if (!node || node === editor) {
              document.execCommand('formatBlock', false, tag);
              updateCount(); updateActiveStates(); return;
            }
            var newEl = document.createElement(tag);
            newEl.innerHTML = node.innerHTML || '<br>';
            node.parentNode.replaceChild(newEl, node);
            var r2 = document.createRange();
            r2.selectNodeContents(newEl); r2.collapse(false);
            sel.removeAllRanges(); sel.addRange(r2);
            updateCount(); updateActiveStates();
          }

          // ── Active toolbar states ─────────────────────────────────────────────
          function updateActiveStates() {
            var sel = window.getSelection();
            var toolbar = document.getElementById('md-toolbar');
            if (!sel || !toolbar) return;
            var node = sel.anchorNode, blockTag = '';
            while (node && node !== editor) {
              if (node.nodeType === 1) { blockTag = node.tagName.toUpperCase(); break; }
              node = node.parentNode;
            }
            toolbar.querySelectorAll('[data-action]').forEach(function (btn) {
              var a = btn.dataset.action, active = false;
              if (a === 'h1' && blockTag === 'H1') active = true;
              if (a === 'h2' && blockTag === 'H2') active = true;
              if (a === 'h3' && blockTag === 'H3') active = true;
              if (a === 'blockquote' && blockTag === 'BLOCKQUOTE') active = true;
              if (a === 'code-block' && blockTag === 'PRE') active = true;
              try {
                if (a === 'bold'      && document.queryCommandState('bold'))      active = true;
                if (a === 'italic'    && document.queryCommandState('italic'))    active = true;
                if (a === 'underline' && document.queryCommandState('underline')) active = true;
              } catch(e){}
              btn.classList.toggle('toolbar-btn--active', active);
            });
          }

          // ── Word count ────────────────────────────────────────────────────────
          function updateCount() {
            var txt = editor.innerText || '';
            if (charEl) charEl.textContent = txt.length;
            if (wordEl) wordEl.textContent = txt.trim() ? txt.trim().split(/\s+/).length : 0;
          }
          editor.addEventListener('input', updateCount);
          editor.addEventListener('keyup', updateActiveStates);
          editor.addEventListener('mouseup', updateActiveStates);
          updateCount();

          // ── Sync to hidden input on submit ────────────────────────────────────
          var form = editor.closest('form');
          if (form) {
            form.addEventListener('submit', function (e) {
              var md = htmlToMd();
              if (!md) { e.preventDefault(); editor.focus(); alert('Content cannot be empty.'); return; }
              hiddenInput.value = md;
            });
          }

          // ── Toolbar clicks ────────────────────────────────────────────────────
          var toolbar = document.getElementById('md-toolbar');
          if (toolbar) {
            toolbar.addEventListener('mousedown', function (e) { e.preventDefault(); });
            toolbar.addEventListener('click', function (e) {
              var btn = e.target.closest('[data-action]');
              if (!btn) return;
              var action = btn.dataset.action;
              editor.focus();
              restoreSel();
              switch (action) {
                case 'h1':         applyBlock('H1'); break;
                case 'h2':         applyBlock('H2'); break;
                case 'h3':         applyBlock('H3'); break;
                case 'paragraph':  applyBlock('P');  break;
                case 'blockquote': applyBlock('BLOCKQUOTE'); break;
                case 'code-block': applyBlock('PRE'); break;
                case 'bold':          document.execCommand('bold');   updateActiveStates(); break;
                case 'italic':        document.execCommand('italic'); updateActiveStates(); break;
                case 'underline':     document.execCommand('underline'); updateActiveStates(); break;
                case 'strikethrough': document.execCommand('strikeThrough'); break;
                case 'ul': document.execCommand('insertUnorderedList'); break;
                case 'ol': document.execCommand('insertOrderedList'); break;
                case 'hr': document.execCommand('insertHTML', false, '<hr><p><br></p>'); break;
                case 'link': {
                  var url = prompt('URL:', 'https://');
                  if (url) document.execCommand('createLink', false, url);
                  break;
                }
                case 'image': {
                  var alt = prompt('Alt text:', 'Image description');
                  var src = prompt('Image URL:', '/images/articles/');
                  if (src) document.execCommand('insertHTML', false, '<img src="' + src + '" alt="' + (alt||'image') + '"><p><br></p>');
                  break;
                }
                case 'faq-heading': {
                  var q = prompt('FAQ question:', 'What is\u2026?');
                  if (q) document.execCommand('insertHTML', false, '<h3>' + q + '</h3><p>Answer goes here.</p>');
                  break;
                }
              }
              updateCount();
            });
          }

          // ── Keyboard shortcuts ────────────────────────────────────────────────
          editor.addEventListener('keydown', function (e) {
            var mod = e.ctrlKey || e.metaKey;
            if (mod && e.key === 'b') { e.preventDefault(); document.execCommand('bold');      updateActiveStates(); }
            if (mod && e.key === 'i') { e.preventDefault(); document.execCommand('italic');    updateActiveStates(); }
            if (mod && e.key === 'u') { e.preventDefault(); document.execCommand('underline'); updateActiveStates(); }
            if (mod && e.key === '1') { e.preventDefault(); applyBlock('H1'); }
            if (mod && e.key === '2') { e.preventDefault(); applyBlock('H2'); }
            if (mod && e.key === '3') { e.preventDefault(); applyBlock('H3'); }
          });

          // ── Preview (rendered HTML) ───────────────────────────────────────────
          var previewing = false;
          if (toggle) {
            toggle.addEventListener('click', function () {
              previewing = !previewing;
              if (previewing) {
                preview.innerHTML = mdToHtml(htmlToMd());
                preview.style.whiteSpace = '';
                preview.style.fontFamily = '';
                preview.style.fontSize = '';
                preview.classList.remove('hidden');
                editor.style.display = 'none';
                toggle.textContent = '\u270F\uFE0F Edit';
              } else {
                preview.classList.add('hidden');
                editor.style.display = '';
                toggle.textContent = '\uD83D\uDC41 Preview';
              }
            });
          }

          // ── Image panel hook ──────────────────────────────────────────────────
          window.__wysiwyg_insert_image = function (url, alt) {
            if (!url) return;
            editor.focus();
            document.execCommand('insertHTML', false, '<img src="' + url + '" alt="' + (alt||'image') + '"><p><br></p>');
            updateCount();
          };
        })();
      </script>

      <!-- Article Images -->
      <div class="bg-white rounded-2xl border border-stone-200 p-6 space-y-4" id="images-panel">
        <div class="flex items-center justify-between">
          <h2 class="text-xs font-bold text-stone-400 uppercase tracking-widest">Article Images</h2>
          <span class="text-xs text-stone-400">Enter a URL then click Insert to add it to the editor</span>
        </div>

        <div class="space-y-3" id="img-slots">
          <!-- slots rendered by JS -->
        </div>

        <p class="text-xs text-stone-400">
          Tip: host images in <code class="bg-stone-100 px-1 rounded">/public/images/articles/</code> and reference them as <code class="bg-stone-100 px-1 rounded">/images/articles/filename.jpg</code>
        </p>
      </div>

      <script is:inline>
        (function () {
          var MAX_SLOTS = 6;
          var slotsEl = document.getElementById('img-slots');
          if (!slotsEl) return;

          function insertImageToEditor(url, alt) {
            if (typeof window.__wysiwyg_insert_image === 'function') {
              window.__wysiwyg_insert_image(url, alt);
            }
          }

          function buildSlot(n) {
            var row = document.createElement('div');
            row.className = 'flex flex-col sm:flex-row gap-2 items-start sm:items-center';
            row.innerHTML =
              '<span class="text-xs font-semibold text-stone-400 w-6 shrink-0 mt-2.5 sm:mt-0">' + n + '</span>' +
              '<input type="url" placeholder="https://… or /images/articles/photo.jpg"' +
              '  class="flex-1 px-3 py-2 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 transition font-mono" />' +
              '<input type="text" placeholder="Alt text (description)"' +
              '  class="w-full sm:w-48 px-3 py-2 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 transition" />' +
              '<button type="button"' +
              '  class="shrink-0 px-3 py-2 bg-slate-900 hover:bg-slate-700 text-white text-xs font-semibold rounded-xl transition whitespace-nowrap">Insert</button>';

            var urlInput = row.querySelectorAll('input')[0];
            var altInput = row.querySelectorAll('input')[1];
            var btn      = row.querySelector('button');

            btn.addEventListener('click', function () {
              var url = urlInput.value.trim();
              var alt = altInput.value.trim();
              if (!url) { urlInput.focus(); return; }
              insertImageToEditor(url, alt);
            });

            // pressing Enter in URL field moves to alt
            urlInput.addEventListener('keydown', function (e) {
              if (e.key === 'Enter') { e.preventDefault(); altInput.focus(); }
            });
            // pressing Enter in alt field inserts
            altInput.addEventListener('keydown', function (e) {
              if (e.key === 'Enter') { e.preventDefault(); btn.click(); }
            });

            return row;
          }

          for (var i = 1; i <= MAX_SLOTS; i++) {
            slotsEl.appendChild(buildSlot(i));
          }
        })();
      </script>

      <!-- Author & Meta -->
      <div class="bg-white rounded-2xl border border-stone-200 p-6 space-y-5">
        <h2 class="text-xs font-bold text-stone-400 uppercase tracking-widest">Author &amp; Metadata</h2>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Author Name <span class="text-red-500">*</span></label>
            <input type="text" name="author" required value="Lamia Akhter"
              class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Title / Affiliation</label>
            <input type="text" name="authorTitle" value="LLB Student & Legal Researcher"
              class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Tags</label>
          <input type="text" name="tags" placeholder="sovereignty, treaty, human rights  (comma-separated)"
            class="w-full px-4 py-2.5 border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition" />
        </div>

        <!-- Publish toggle -->
        <div class="bg-stone-50 border border-stone-200 rounded-xl p-4">
          <label class="flex items-center gap-4 cursor-pointer select-none">
            <input type="hidden" name="published" value="0" />
            <div class="relative">
              <input type="checkbox" name="published" value="1" id="pub-toggle"
                class="sr-only peer" />
              <div class="w-11 h-6 bg-stone-300 rounded-full peer-checked:bg-emerald-500 transition-colors"></div>
              <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform peer-checked:translate-x-5"></div>
            </div>
            <div>
              <div class="text-sm font-semibold text-slate-700">Publish immediately</div>
              <div class="text-xs text-stone-400">Off = save as draft (not visible on site)</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <button type="submit"
          class="bg-slate-900 hover:bg-slate-800 text-white font-semibold px-7 py-3 rounded-xl text-sm transition-colors flex items-center justify-center gap-2">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Save Article
        </button>
        <a href="/admin" class="text-sm text-stone-500 hover:text-slate-800 px-5 py-3 rounded-xl border border-stone-200 hover:border-stone-400 text-center transition-all">
          Cancel
        </a>
      </div>

    </form>
  </div>

  <script>
    function autoSlug(v: string) {
      (document.getElementById('slug') as HTMLInputElement).value =
        v.toLowerCase().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-').slice(0,80);
    }
    (window as any).autoSlug = autoSlug;
  </script>

</AdminLayout>
