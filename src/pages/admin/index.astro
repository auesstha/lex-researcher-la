---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAuthenticated } from '../../lib/auth';
import { getArticles, deleteArticle, CATEGORIES, getBadgeClass } from '../../lib/articles';
import type { CategorySlug } from '../../lib/articles';

if (!isAuthenticated(Astro.request)) {
  return Astro.redirect('/admin/login');
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('action') === 'delete' && form.get('id')) {
    await deleteArticle(Astro.locals, form.get('id') as string);
  }
  return Astro.redirect('/admin');
}

const articles = (await getArticles(Astro.locals)).sort(
  (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime()
);

const published = articles.filter(a => a.published).length;
const drafts    = articles.length - published;

const catCount: Record<string, number> = {};
for (const a of articles) catCount[a.category] = (catCount[a.category] || 0) + 1;
const topCat = Object.entries(catCount).sort((a,b) => b[1]-a[1])[0];

function fmt(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---
<AdminLayout title="All Articles">

  <!-- Stats row -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-2xl border border-stone-200 p-5">
      <div class="text-xs font-bold text-stone-400 uppercase tracking-wider mb-1">Total Articles</div>
      <div class="text-3xl font-bold text-slate-900">{articles.length}</div>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-5">
      <div class="text-xs font-bold text-stone-400 uppercase tracking-wider mb-1">Published</div>
      <div class="text-3xl font-bold text-emerald-600">{published}</div>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-5">
      <div class="text-xs font-bold text-stone-400 uppercase tracking-wider mb-1">Drafts</div>
      <div class="text-3xl font-bold text-amber-500">{drafts}</div>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-5">
      <div class="text-xs font-bold text-stone-400 uppercase tracking-wider mb-1">Top Category</div>
      <div class="text-sm font-bold text-slate-900 mt-1 leading-snug">
        {topCat ? CATEGORIES[topCat[0] as CategorySlug]?.shortLabel ?? topCat[0] : '—'}
      </div>
    </div>
  </div>

  <!-- Table card -->
  <div class="bg-white rounded-2xl border border-stone-200 overflow-hidden">

    <!-- Table header -->
    <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-stone-100">
      <h2 class="font-semibold text-slate-800">Articles</h2>
      <a href="/admin/articles/new"
         class="inline-flex items-center gap-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold px-3 py-2 rounded-lg transition-colors">
        <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        New Article
      </a>
    </div>

    {articles.length === 0 ? (
      <div class="text-center py-20 px-6">
        <div class="w-16 h-16 bg-stone-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-stone-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <p class="text-stone-500 font-medium mb-1">No articles yet</p>
        <p class="text-stone-400 text-sm mb-5">Create your first research article to get started.</p>
        <a href="/admin/articles/new" class="inline-flex items-center gap-2 bg-slate-900 text-white font-semibold px-5 py-2.5 rounded-xl text-sm hover:bg-slate-800 transition-colors">
          Write First Article
        </a>
      </div>
    ) : (
      <>
        <!-- Desktop table -->
        <div class="hidden md:block overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-stone-50 border-b border-stone-100">
                <th class="text-left px-6 py-3 text-xs font-bold text-stone-400 uppercase tracking-wider">Title</th>
                <th class="text-left px-4 py-3 text-xs font-bold text-stone-400 uppercase tracking-wider">Category</th>
                <th class="text-left px-4 py-3 text-xs font-bold text-stone-400 uppercase tracking-wider">Date</th>
                <th class="text-left px-4 py-3 text-xs font-bold text-stone-400 uppercase tracking-wider">Status</th>
                <th class="text-right px-6 py-3 text-xs font-bold text-stone-400 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
              {articles.map(a => {
                const cat = CATEGORIES[a.category as CategorySlug];
                return (
                  <tr class="hover:bg-stone-50 transition-colors group">
                    <td class="px-6 py-4 max-w-xs">
                      <div class="font-semibold text-slate-800 truncate group-hover:text-slate-900">{a.title}</div>
                      <div class="text-xs text-stone-400 mt-0.5 truncate">/articles/{a.slug}</div>
                    </td>
                    <td class="px-4 py-4">
                      <span class={`inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full border ${getBadgeClass(cat?.color ?? 'stone')}`}>
                        {cat?.icon} {cat?.shortLabel ?? a.category}
                      </span>
                    </td>
                    <td class="px-4 py-4 text-stone-500 text-xs whitespace-nowrap">{fmt(a.publishedAt)}</td>
                    <td class="px-4 py-4">
                      {a.published
                        ? <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-full">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Published
                          </span>
                        : <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-full">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>Draft
                          </span>
                      }
                    </td>
                    <td class="px-6 py-4">
                      <div class="flex items-center justify-end gap-2">
                        <a href={`/articles/${a.slug}`} target="_blank"
                           class="p-2 rounded-lg text-stone-400 hover:text-slate-700 hover:bg-stone-100 transition-colors" title="Preview">
                          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        </a>
                        <a href={`/admin/articles/${a.id}/edit`}
                           class="p-2 rounded-lg text-stone-400 hover:text-slate-700 hover:bg-stone-100 transition-colors" title="Edit">
                          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                        </a>
                        <form method="POST" onsubmit="return confirm('Delete this article permanently?')">
                          <input type="hidden" name="action" value="delete" />
                          <input type="hidden" name="id" value={a.id} />
                          <button type="submit" class="p-2 rounded-lg text-stone-400 hover:text-red-600 hover:bg-red-50 transition-colors" title="Delete">
                            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <!-- Mobile card list -->
        <div class="md:hidden divide-y divide-stone-100">
          {articles.map(a => {
            const cat = CATEGORIES[a.category as CategorySlug];
            return (
              <div class="px-5 py-4">
                <div class="flex items-start justify-between gap-3 mb-2">
                  <div class="font-semibold text-slate-800 text-sm leading-snug flex-1">{a.title}</div>
                  {a.published
                    ? <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full flex-shrink-0">Live</span>
                    : <span class="text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full flex-shrink-0">Draft</span>
                  }
                </div>
                <div class="flex items-center gap-2 mb-3">
                  <span class={`text-xs font-semibold px-2 py-0.5 rounded-full border ${getBadgeClass(cat?.color ?? 'stone')}`}>
                    {cat?.icon} {cat?.shortLabel}
                  </span>
                  <span class="text-xs text-stone-400">{fmt(a.publishedAt)}</span>
                </div>
                <div class="flex items-center gap-2">
                  <a href={`/admin/articles/${a.id}/edit`}
                     class="flex-1 text-center text-xs font-semibold bg-stone-100 hover:bg-stone-200 text-slate-700 px-3 py-2 rounded-lg transition-colors">
                    Edit
                  </a>
                  <a href={`/articles/${a.slug}`} target="_blank"
                     class="flex-1 text-center text-xs font-semibold border border-stone-200 text-stone-500 hover:text-slate-800 px-3 py-2 rounded-lg transition-colors">
                    Preview ↗
                  </a>
                  <form method="POST" onsubmit="return confirm('Delete?')">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="id" value={a.id} />
                    <button type="submit" class="p-2 rounded-lg text-stone-400 hover:text-red-600 hover:bg-red-50 transition-colors">
                      <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                  </form>
                </div>
              </div>
            );
          })}
        </div>
      </>
    )}
  </div>

</AdminLayout>
